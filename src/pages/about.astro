---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "Over two decades of making technical and commercial decisions and living with the consequences. Architecture, business development, and delivery advice grounded in direct experience.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Technical and Commercial Advisor, Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Università degli Studi di Milano",
    },
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="Over two decades of making technical and commercial decisions and living with the results. Architecture, business development, tender assessment, partner and vendor management."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Maurizio Turatti, architecture advisor, technical due diligence, CTO advisory, architectural decisions, software architecture, business development, lead evaluation, tender assessment, public sector tenders, private sector tenders, partnership structuring, vendor management, contract negotiation, RFP response management"
    />
  </Fragment>
  <div class="hero hero--first">
    <p class="hero-eyebrow">About</p>
    <h1 class="hero-headline">Professional summary.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          Co-founder of SoftInstigate since 2014. Technical and commercial
          advisor. Built and operated production systems since 1998: real-time
          distributed systems and GIS visualization at Artificial Intelligence
          Software, SOA and EAI integration at Sun Microsystems and SeeBeyond,
          enterprise content platforms at AKQA and Alfresco, and now
          cloud-native AI integration and RAG systems on MongoDB. On the
          commercial side: business development, lead evaluation, tender
          assessment, partner and vendor management, contract negotiation and
          execution.
        </p>
      </div>
    </div>

    <!-- How I work -->
    <div class="section-block">
      <h2 class="section-title">How I work</h2>
      <div class="card-grid card-grid--featured">
        <div class="surface-card">
          <p class="card-label">Commercial and technical together</p>
          <p class="card-title">Separating them is where problems start</p>
          <p class="card-text">
            Commercial and technical decisions are made together or they become
            problems for each other. A proposal that ignores technical
            constraints becomes a delivery crisis. An architecture that ignores
            commercial reality does not survive the contract.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Tenders and proposals</p>
          <p class="card-title">The proposal is the first architecture decision</p>
          <p class="card-text">
            A tender response is a technical and commercial commitment made
            before the team is assembled and the constraints are fully known. I
            assess feasibility, estimate effort, structure partnerships, and
            frame the technical approach so the proposal can survive delivery.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Decisions under uncertainty</p>
          <p class="card-title">You have to decide before certainty</p>
          <p class="card-text">
            Both commercial and technical decisions are made with incomplete
            information. The ones that matter are the ones where the
            consequences of being wrong are visible and expensive: in the
            contract, in the architecture, or in both.
          </p>
        </div>
      </div>
    </div>

    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">What I do</h2>
      <div class="card-grid card-grid--featured">
        <div class="surface-card">
          <p class="card-label">Opportunity assessment</p>
          <p class="card-title">A few hours now save weeks later</p>
          <p class="card-text">
            I evaluate leads and qualify opportunities with the commercial
            team. I have seen enough projects start on wrong assumptions to
            know that the cheapest place to kill a bad opportunity is before
            the first proposal.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Technical and commercial evaluation</p>
          <p class="card-title">What to find before the commitment</p>
          <p class="card-text">
            I assess technical maturity and architecture risks before
            investment, acquisition, or project commitment. Due diligence is
            where I find the structural problems that would otherwise surface
            after closing, when fixing them costs ten times more.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Partnerships and vendors</p>
          <p class="card-title">What a platform costs over twelve months</p>
          <p class="card-text">
            I evaluate vendors and platforms, structure partnerships, and
            manage relationships through delivery. The proposal price is
            visible. Integration effort, migration risk, and operational
            overhead over the life of the project are the numbers that
            determine whether the choice was right.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Proposals and delivery</p>
          <p class="card-title">The proposal commits more than people think</p>
          <p class="card-text">
            I assess public and private tenders and lead client-facing
            delivery. A wrong assumption in the proposal becomes a structural
            problem when the team starts building. I have seen projects that
            were technically sound but commercially underpriced, and the
            delivery team paid for it.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Contracts</p>
          <p class="card-title">What gets delivered is decided here</p>
          <p class="card-text">
            I negotiate and execute contracts for technical projects. The
            contract locks scope and constraints before the first line of
            code. If the technical reality and the commercial terms do not
            agree at that point, the project starts with a debt it cannot
            repay.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Technical strategy</p>
          <p class="card-title">Architecture that holds under pressure</p>
          <p class="card-text">
            Architecture reviews, distributed systems, and AI integration.
            I focus on the decisions that determine how the system behaves
            when the load doubles or the requirements shift. Those are the
            decisions that are expensive to undo.
          </p>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">AI adoption and architecture</h2>
      <div class="section-body">
        <p>
          AI is a multiplier of what is already there. It can accelerate
          development, and it can accelerate decay.
        </p>
        <p>
          AI follows a pattern: <strong>Envision</strong>, <strong
            >Experiment</strong
          >, <strong>Launch</strong>, <strong>Scale</strong>. Most startups and
          scale-ups are between Experiment and Launch. They have something
          working, but the architecture was built for speed, not for the load AI
          puts on it.
        </p>
        <p>
          The transition from pilot to production is where decisions become
          expensive to undo: what happens when the model changes, who owns
          output quality, how do you handle costs, what is the fallback when the
          AI is wrong.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Open source</h2>
      <div class="section-body">
        <p>
          <a
            href="https://github.com/SoftInstigate/restheart"
            target="_blank"
            rel="noopener"><strong>RESTHeart</strong></a
          >: Agent-ready backend for MongoDB<br />
          <a
            href="https://github.com/SoftInstigate/facet"
            target="_blank"
            rel="noopener"><strong>Facet</strong></a
          >: Data-driven web framework: turn APIs into HTML, zero code<br />
          <a
            href="https://github.com/SoftInstigate/ermes-mail"
            target="_blank"
            rel="noopener"><strong>Ermes Mail</strong></a
          >: Async e-mail library and CLI for Java<br />
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener"
            >All projects on GitHub →</a
          >
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Teaching</h2>
      <div class="section-body">
        <p>
          Created and delivered technical courses and workshops for enterprise
          clients and partner networks across Italy and EMEA. Teaching forced me
          to articulate why certain decisions are made, which sharpened my own
          judgment.
        </p>
      </div>
    </div>

    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
