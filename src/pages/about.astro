---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "I have worked in software development since 1998, building distributed systems, integrations and content platforms for early-stage startups and established companies.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Software Architect",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://www.softinstigate.com",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Universita degli Studi di Milano",
    },
    knowsAbout: [
      "System design",
      "Distributed systems",
      "API design",
      "Data platforms",
      "Java",
      "AWS",
      "Docker",
      "MongoDB",
      "AI integration",
      "Technical leadership",
    ],
  },
};
---

<Base
  title="About | Maurizio Turatti"
  description="I have worked in software development since 1998, building distributed systems, integrations and content platforms for early-stage startups and established companies."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>

  <header class="hero hero--about grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">About</div>
      <h1>Technical strategy<br />with a <em>business edge</em></h1>
      <div class="hero-about-flex">
        <div class="hero-about-photo">
          <img
            src="/images/maurizio.webp"
            alt="Maurizio Turatti"
            width="200"
            height="200"
            loading="eager"
          />
        </div>
        <div class="hero-about-text">
          <p>
            I have worked in software development since 1998, building distributed
            systems, integrations and content platforms for early-stage startups
            and established companies.
          </p>
          <p class="mono">Milan area, Italy &middot; Italian, English</p>
        </div>
      </div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Background</h2>
      </div>
      <p>
        My early work was in real-time distributed systems and 3D visualization.
        I moved through SOA and enterprise integration at SeeBeyond and Sun
        Microsystems, then into content platforms at AKQA and Alfresco. I
        co-founded SoftInstigate in 2014 and spent the following years building
        and operating backend systems in production.
      </p>
      <p>
        I have worked with Java for more than twenty years, and with MongoDB
        and AWS for more than ten.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Three levels of design</h2>
      </div>

      <div class="steps steps--3">
        <div class="step">
          <svg
            class="step-visual"
            viewBox="0 0 240 120"
            fill="none"
            aria-hidden="true"
          >
            <rect
              x="12"
              y="12"
              width="76"
              height="48"
              rx="4"
              stroke="var(--text-muted)"
              stroke-opacity=".55"
              stroke-dasharray="3 3"></rect>
            <rect
              x="152"
              y="12"
              width="76"
              height="48"
              rx="4"
              stroke="var(--text-muted)"
              stroke-opacity=".55"
              stroke-dasharray="3 3"></rect>
            <rect
              x="82"
              y="64"
              width="76"
              height="48"
              rx="4"
              stroke="var(--text-muted)"
              stroke-opacity=".55"
              stroke-dasharray="3 3"></rect>
            <rect
              x="22"
              y="22"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <rect
              x="162"
              y="22"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <rect
              x="92"
              y="74"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <path
              d="M78 36H162M50 50L100 74M190 50L140 74"
              stroke="var(--text-muted)"
              stroke-width="1.2"></path>
          </svg>
          <h3>Architecture</h3>
          <p>
            Architecture sets the boundaries between components and the patterns
            that connect them, such as microservices or event-driven
            integration. Once the system is in production, it is the hardest
            part of the design to change.
          </p>
        </div>
        <div class="step">
          <svg
            class="step-visual"
            viewBox="0 0 240 120"
            fill="none"
            aria-hidden="true"
          >
            <rect
              x="6"
              y="6"
              width="140"
              height="108"
              rx="10"
              stroke="var(--text-muted)"
              stroke-dasharray="4 3"></rect>
            <rect
              x="160"
              y="6"
              width="74"
              height="108"
              rx="2"
              stroke="var(--text-muted)"></rect>
            <path d="M160 30H234M160 90H234" stroke="var(--line)"></path>
            <text
              x="14"
              y="108"
              fill="var(--text-muted)"
              font-family="IBM Plex Mono, monospace"
              font-size="9">cloud</text
            >
            <text
              x="166"
              y="108"
              fill="var(--text-muted)"
              font-family="IBM Plex Mono, monospace"
              font-size="9">on-prem</text
            >
            <rect
              x="22"
              y="22"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <rect
              x="72"
              y="66"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <rect
              x="169"
              y="46"
              width="56"
              height="28"
              rx="2"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <path
              d="M50 50L92 66M78 36H150V60H169M128 80H150V70H169"
              stroke="var(--text-muted)"
              stroke-width="1.2"></path>
          </svg>
          <h3>System design</h3>
          <p>
            System design maps the logical architecture onto cloud or
            on-premises infrastructure. It decides how the system handles
            traffic peaks and server failures.
          </p>
        </div>
        <div class="step">
          <svg
            class="step-visual"
            viewBox="0 0 240 120"
            fill="none"
            aria-hidden="true"
          >
            <rect
              x="40"
              y="8"
              width="160"
              height="104"
              rx="3"
              stroke="var(--accent)"
              stroke-width="1.4"></rect>
            <path d="M40 26H200" stroke="var(--accent)" stroke-width="1"></path>
            <path
              d="M56 42H136M64 54H156M64 66H120M56 78H144M64 90H108"
              stroke="var(--text-muted)"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <circle
              cx="176"
              cy="92"
              r="11"
              stroke="var(--accent)"
              stroke-width="1.4"></circle>
            <path
              d="M171 92L175 96L182 88"
              stroke="var(--accent)"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <h3>Software design</h3>
          <p>
            Software design is the structure of the code inside each component.
            I write it test-first and refactor it continuously, and every change
            goes through continuous integration. Code written by AI agents goes
            through the same tests before it is merged.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Teaching</h2>
      </div>
      <p>
        I created and delivered technical courses and workshops for enterprise
        clients and partner networks across Italy and EMEA.
      </p>
      <p>
        I am the author of Instant Apache Maven Starter (Packt Publishing,
        2013).
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Products and open source</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name"><a href="https://restheart.org/">RESTHeart</a></div>
          <div class="desc">The agent-native backend for MongoDB</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://cloud.restheart.com">RESTHeart Cloud</a>
          </div>
          <div class="desc">Managed agent-native backend platform</div>
        </div>
        <div class="link-row">
          <div class="name"><a href="https://bysophia.ai/">Sophia</a></div>
          <div class="desc">RAG platform for AI agents on company knowledge</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://www.softinstigate.com/en/mobility/">MobiStream</a>
          </div>
          <div class="desc">Event data platform for mobility and IoT</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/facet">Facet</a>
          </div>
          <div class="desc">
            Data-driven web framework: turn a REST API into HTML content
          </div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/ermes-mail">Ermes Mail</a>
          </div>
          <div class="desc">Async e-mail library and CLI for Java</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/mkjsix">All projects on GitHub &rarr;</a
            >
          </div>
          <div class="desc"></div>
        </div>
      </div>
    </div>
  </section>


  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Get in touch</h2>
      </div>
      <ContactCta />
    </div>
  </section>
</Base>
