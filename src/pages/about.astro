---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "Software architect and product engineer. Co-founder of SoftInstigate, creator of RESTHeart. A career built on shipping real systems across enterprise, agency, and product.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Software Architect & Product Engineer",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Università degli Studi di Milano",
    },
  },
};
---

<Base
  title="About — Maurizio Turatti"
  description="Software architect and product engineer. Co-founder of SoftInstigate, creator of RESTHeart. A career built on shipping real systems across enterprise, agency, and product."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/Maurizio_Turatti_CV.md" title="Maurizio Turatti CV (Markdown)" />
    <meta name="keywords" content="Maurizio Turatti CV, software architect CV, technical advisor CV, architecture consultant CV" />
  </Fragment>
  <div class="hero hero--first">
    <p class="hero-eyebrow">About</p>
    <h1 class="hero-headline">Shipping real systems.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          Software architect, entrepreneur, and product engineer with 25+ years
          of experience. Co-founder of
          <a href="https://restheart.org" target="_blank" rel="noopener"
            >SoftInstigate</a
          > and creator of RESTHeart, an open-source backend for MongoDB with
          2M+ downloads. I have built products, grown a consulting business,
          and owned the full delivery chain from code to production: CI/CD,
          infrastructure automation, observability, and cloud operations.
          Former SOA architect at Sun Microsystems and technical architect at
          AKQA Berlin.
        </p>
        <p>
          I combine hands-on architecture with business development and
          product strategy. That mix is what I bring to fractional CTO and
          advisory engagements.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:16px;">
          <a href="/Maurizio_Turatti_CV.md" download="Maurizio_Turatti_CV.md" class="cta-btn cta-btn--primary">Download CV (Markdown)</a>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-text">
              Technical Architect for a global luxury brand's e-commerce platform in
              China. Coordinated distributed engineering teams across Berlin,
              Geneva, and Shanghai.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Stabilization of a high-volume production backend serving 2,600+ stores and 9,500+
              terminals: 141M+ documents, 1TB+ data. Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; public sector</p>
            <p class="card-text">
              Traffic data platform (GART) for ACI group, integrating 15+ regional
              and national sources in DATEX II format. AWS ECS, Lambda, CloudFront,
              MongoDB Atlas. In production since 2017 with zero critical outages under a 7/7 365-day SLA.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-text">
              Architectural assessment of a public-facing compliance platform:
              over a million users, millions of requests per hour, sub-second response times.
              Performance analysis and strategic roadmap.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-text">
              RESTHeart integrated as core persistence and API layer for Crownpeak
              Content-as-a-Service, deployed on Kubernetes to thousands of enterprise
              clients globally across Europe and North America.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 2M+ open-source downloads, 10+ years in production.
              Agent-ready backend for MongoDB, adopted by Fortune 500 companies
              including Unisys, Northrop Grumman, and Crownpeak.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Career</h2>
      <div class="section-body section-body--spacious">
        <p>
          <strong>SoftInstigate</strong>, Co-Founder &amp; Technical Advisor
          (2014 – present)<br />
          Product development and advisory across automotive, retail, sustainability,
          and public sector. Focus on backend architecture, cloud transformation,
          platform strategy, and DevOps: I own the automation layer across the
          full delivery chain, from build pipelines to infrastructure provisioning,
          monitoring, and production operations.
        </p>
        <ul>
          <li>Co-created RESTHeart: 2M+ downloads, 10+ years in production, adopted by Fortune 500 companies including Unisys, Northrop Grumman, and Crownpeak</li>
          <li>Designed and delivered GART (ACI group): in production since 2017, zero critical outages, 7/7 365-day SLA</li>
          <li>Led backend modernization for a retail platform: throughput target exceeded by 79%, query time reduced 216x</li>
        </ul>
        <p>
          <strong>AKQA</strong>, Technical Architect, Berlin (2013 – 2014)<br />
          Technical architect for enterprise digital transformation at a global digital
          agency. Delivered the Montblanc e-commerce platform in China, coordinating
          distributed engineering teams across Berlin, Geneva, and Shanghai.
        </p>
        <p>
          <strong>Sourcesense</strong>, Delivery Manager (2011 – 2013)<br />
          Led a consulting team delivering open-source enterprise solutions across
          finance, telecom, and public sector. Combined technical leadership with
          commercial responsibilities.
        </p>
        <p>
          <strong>Alfresco</strong>, Senior Solutions Engineer, Italy (2010 –
          2011)<br />
          Supported the launch of Alfresco's Italian market operations. Pre-sales
          consulting and technical engagements for enterprise content management.
        </p>
        <p>
          <strong>Earlier career (1997 – 2010)</strong><br />
          Progressive career across enterprise integration, distributed systems, and
          software research: SOA architect at Sun Microsystems for Italy and
          the EMEA region, SOA/EAI consulting at SeeBeyond, founding an independent
          consulting practice, and research in computational geometry and machine
          learning at the Università degli Studi di Milano.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Open source</h2>
      <div class="section-body">
        <p>
          <a
            href="https://github.com/SoftInstigate/restheart"
            target="_blank"
            rel="noopener"><strong>RESTHeart</strong></a
          >: The agent-ready backend for MongoDB (Java, GraalVM)<br />
          <a
            href="https://github.com/SoftInstigate/facet"
            target="_blank"
            rel="noopener"><strong>Facet</strong></a
          >: Data-driven web framework: turn APIs into HTML, zero code<br />
          <a
            href="https://github.com/SoftInstigate/ermes-mail"
            target="_blank"
            rel="noopener"><strong>Ermes Mail</strong></a
          >: Async e-mail library and CLI for Java<br />
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener"
            >All projects on GitHub →</a
          >
        </p>
      </div>
    </div>
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
