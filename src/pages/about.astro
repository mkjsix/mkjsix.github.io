---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "I have worked in software development since 1998, building distributed systems, integrations and content platforms for early-stage startups and established companies.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Software Architect",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://www.softinstigate.com",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Universita degli Studi di Milano",
    },
    knowsAbout: [
      "System design",
      "Distributed systems",
      "API design",
      "Data platforms",
      "Java",
      "AWS",
      "Docker",
      "MongoDB",
      "AI integration",
      "Technical leadership",
    ],
  },
};
---

<Base
  title="About | Maurizio Turatti"
  description="I have worked in software development since 1998, building distributed systems, integrations and content platforms for early-stage startups and established companies."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>

  <header class="hero hero--about grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">About</div>
      <h1>Technical strategy<br />with a <em>business edge</em></h1>
      <div class="hero-about-flex">
        <div class="hero-about-photo">
          <img
            src="/images/maurizio.webp"
            alt="Maurizio Turatti"
            width="200"
            height="200"
            loading="eager"
          />
        </div>
        <div class="hero-about-text">
          <p>
            I have worked in software development since 1998, building distributed
            systems, integrations and content platforms for early-stage startups
            and established companies.
          </p>
          <p class="mono">Milan area, Italy &middot; Italian, English</p>
        </div>
      </div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Background</h2>
      </div>
      <p>
        My early work was in real-time distributed systems and 3D visualization.
        I moved through SOA and enterprise integration at SeeBeyond and Sun
        Microsystems, then into content platforms at AKQA and Alfresco. I
        co-founded SoftInstigate in 2014 and spent the following years building
        and operating backend systems in production.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Skills by level of design</h2>
      </div>
      <div class="steps skills-grid">
        <div class="step">
          <h3>Architecture</h3>
          <ul>
            <li>Distributed systems</li>
            <li>API design</li>
            <li>Data platforms</li>
          </ul>
        </div>
        <div class="step">
          <h3>System design</h3>
          <ul>
            <li>AWS</li>
            <li>Docker</li>
            <li>MongoDB</li>
          </ul>
        </div>
        <div class="step">
          <h3>Software design</h3>
          <ul>
            <li>Java</li>
            <li>Test-driven development</li>
            <li>Continuous refactoring</li>
            <li>Continuous integration</li>
          </ul>
        </div>
        <div class="step">
          <h3>Across levels</h3>
          <ul>
            <li>AI integration</li>
            <li>Technical leadership</li>
            <li>Client-side technical governance</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Products</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name"><a href="https://restheart.org/">RESTHeart</a></div>
          <div class="desc">The agent-native backend for MongoDB</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://cloud.restheart.com">RESTHeart Cloud</a>
          </div>
          <div class="desc">Managed agent-native backend platform</div>
        </div>
        <div class="link-row">
          <div class="name"><a href="https://bysophia.ai/">Sophia</a></div>
          <div class="desc">RAG platform for AI agents on company knowledge</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://www.softinstigate.com/en/mobility/">MobiStream</a>
          </div>
          <div class="desc">Event data platform for mobility and IoT</div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Open source</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/facet">Facet</a>
          </div>
          <div class="desc">
            Data-driven web framework: turn a REST API into HTML content
          </div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/ermes-mail">Ermes Mail</a>
          </div>
          <div class="desc">Async e-mail library and CLI for Java</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/mkjsix">All projects on GitHub &rarr;</a
            >
          </div>
          <div class="desc"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Teaching</h2>
      </div>
      <p>
        I created and delivered technical courses and workshops for enterprise
        clients and partner networks across Italy and EMEA.
      </p>
      <p>
        I am the author of Instant Apache Maven Starter (Packt Publishing,
        2013).
      </p>
    </div>
  </section>


  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Get in touch</h2>
      </div>
      <ContactCta />
    </div>
  </section>
</Base>
