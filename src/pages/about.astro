---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Technical and Commercial Advisor, Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Università degli Studi di Milano",
    },
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Maurizio Turatti, technical leadership, system design, software architecture, architectural decisions, technical strategy, CTO advisory, technical due diligence, distributed systems, API design, AI integration, product architecture, delivery guidance"
    />
  </Fragment>
  <div class="hero hero--first">
    <p class="hero-eyebrow">About</p>
    <h1 class="hero-headline">Decisions made before certainty.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          I have been working with software since 1998, building distributed
          systems, integrations, and content platforms for organizations that
          needed the architecture to hold under operational pressure. Technical
          choices shape business outcomes long after the first release.
        </p>
        <p>
          I help teams decide what is feasible, where to commit, and which risks
          become visible after delivery. That means working on architecture under
          uncertainty, system boundaries between organizations, and technical
          choices that have commercial consequences.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Background</h2>
      <div class="section-body">
        <p>
          My early work was in real-time distributed systems and GIS
          visualization at AI Software. I then moved into SOA and EAI at Sun
          Microsystems and SeeBeyond, followed by enterprise content platforms at
          AKQA and Alfresco. I co-founded <a href="https://softinstigate.com">SoftInstigate</a> in 2014 and spent the
          next years building and operating RESTHeart and related systems in
          production.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">How I work</h2>
      <div class="card-grid card-grid--featured">
        <div class="surface-card">
          <p class="card-label">Commercial and technical together</p>
          <p class="card-title">The important decisions are made together</p>
          <p class="card-text">
            Commercial and technical choices are linked. A pricing decision that
            ignores platform complexity creates delivery pressure. A technical
            decision made without commercial constraints creates delivery risk,
            and it usually appears at the worst moment.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Integration across organizations</p>
          <p class="card-title">The system boundary is part of the design</p>
          <p class="card-text">
            When two organizations have to work together, the architecture is not
            only the code. The boundary defines what each side owns, what is
            shared, and what breaks when the assumptions change.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Decisions under uncertainty</p>
          <p class="card-title">Most important choices are made before the facts are complete</p>
          <p class="card-text">
            Important decisions are often made with incomplete information. When
            the cost of a wrong call shows up in the contract, the roadmap, or the
            system design, judgment matters more than analysis volume.
          </p>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">AI adoption and architecture</h2>
      <div class="section-body">
        <p>
          AI changes the speed of execution more than the shape of the decision.
          A pilot can look promising for a month. Production reveals model
          drift, ownership of output quality, and the cost of fallback paths.
        </p>
        <p>
          The hard part is usually not the model itself. It is the process around
          it: the data flow, the ownership, the operational controls, and the
          decision to keep a human path when the system is wrong.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Products</h2>
      <div class="section-body">
        <p>
          <a href="https://restheart.org/" target="_blank" rel="noopener"
            ><strong>RESTHeart</strong></a
          >: Backend and API platform for MongoDB<br />
          <a
            href="https://cloud.restheart.com"
            target="_blank"
            rel="noopener"><strong>RESTHeart Cloud</strong></a
          >: Managed RESTHeart services<br />
          <a href="https://bysophia.ai" target="_blank" rel="noopener"
            ><strong>bySophia</strong></a
          >: AI platform for working with business knowledge
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Open source</h2>
      <div class="section-body">
        <p>
          <a
            href="https://github.com/SoftInstigate/restheart"
            target="_blank"
            rel="noopener"><strong>RESTHeart</strong></a
          >: Agent-ready backend for MongoDB<br />
          <a
            href="https://github.com/SoftInstigate/facet"
            target="_blank"
            rel="noopener"><strong>Facet</strong></a
          >: Data-driven web framework: turn APIs into HTML, zero code<br />
          <a
            href="https://github.com/SoftInstigate/ermes-mail"
            target="_blank"
            rel="noopener"><strong>Ermes Mail</strong></a
          >: Async e-mail library and CLI for Java<br />
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener"
            >All projects on GitHub →</a
          >
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Teaching</h2>
      <div class="section-body">
        <p>
          I created and delivered technical courses and workshops for enterprise
          clients and partner networks across Italy and EMEA. Teaching forces me
          to explain why decisions are made, and that sharpens judgment in the
          work itself.
        </p>
      </div>
    </div>

    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
