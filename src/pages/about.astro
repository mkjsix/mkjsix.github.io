---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "Architecture, delivery, and commercial judgment under uncertainty. Technical decisions that shape what gets built and what survives delivery.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Technical and Commercial Advisor, Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Università degli Studi di Milano",
    },
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="Architecture, delivery, and commercial judgment under uncertainty. Technical decisions that shape what gets built and what survives delivery."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Maurizio Turatti, architecture advisor, technical due diligence, CTO advisory, architectural decisions, software architecture, business development, lead evaluation, tender assessment, public sector tenders, private sector tenders, partnership structuring, vendor management, contract negotiation, RFP response management"
    />
  </Fragment>
  <div class="hero hero--first">
    <p class="hero-eyebrow">About</p>
    <h1 class="hero-headline">Decisions made before certainty.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          I work where architecture stops being a technical exercise and starts
          being a business decision. The problem is rarely the code. It is the
          decision made too early, the constraint accepted too late, or the
          system designed for the wrong failure mode.
        </p>
        <p>
          I help teams decide what is feasible, where to commit, and which risks
          will surface after delivery. That means working on architecture under
          uncertainty, on system integration across organizations, and on
          technical choices that have commercial consequences.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">How I work</h2>
      <div class="card-grid card-grid--featured">
        <div class="surface-card">
          <p class="card-label">Commercial and technical together</p>
          <p class="card-title">Separating them is where problems start</p>
          <p class="card-text">
            Commercial and technical decisions are made together or they become
            problems for each other. The commercial side defines what gets built,
            and the technical side determines whether it can hold.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Integration across organizations</p>
          <p class="card-title">The boundary is the design</p>
          <p class="card-text">
            When two organizations have to work together, the architecture is not
            just code. It is the boundary that defines what each side owns, what
            is shared, and what breaks when the assumptions change.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Decisions under uncertainty</p>
          <p class="card-title">You have to decide before certainty</p>
          <p class="card-text">
            Most important decisions are made with incomplete information. The
            quality of the judgment matters more than the volume of the analysis,
            especially when the cost of a wrong call is visible in the contract,
            the roadmap, or the architecture.
          </p>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">AI adoption and architecture</h2>
      <div class="section-body">
        <p>
          AI changes the speed of execution, not the nature of the decision. It
          can accelerate delivery, and it can accelerate decay.
        </p>
        <p>
          The real question is not whether the model works in a pilot. It is
          whether the process, the data, the ownership, and the fallback are
          designed for production. That is where most projects fail, not in the
          first experiment, but in the transition to real use.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Open source</h2>
      <div class="section-body">
        <p>
          <a
            href="https://github.com/SoftInstigate/restheart"
            target="_blank"
            rel="noopener"><strong>RESTHeart</strong></a
          >: Agent-ready backend for MongoDB<br />
          <a
            href="https://github.com/SoftInstigate/facet"
            target="_blank"
            rel="noopener"><strong>Facet</strong></a
          >: Data-driven web framework: turn APIs into HTML, zero code<br />
          <a
            href="https://github.com/SoftInstigate/ermes-mail"
            target="_blank"
            rel="noopener"><strong>Ermes Mail</strong></a
          >: Async e-mail library and CLI for Java<br />
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener"
            >All projects on GitHub →</a
          >
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Teaching</h2>
      <div class="section-body">
        <p>
          I created and delivered technical courses and workshops for enterprise
          clients and partner networks across Italy and EMEA. Teaching forces me
          to explain why decisions are made, and that sharpens judgment in the
          work itself.
        </p>
      </div>
    </div>

    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
