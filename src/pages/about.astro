---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ContactCta from "../components/ContactCta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Technical and Commercial Advisor, Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://www.softinstigate.com",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Universita degli Studi di Milano",
    },
    knowsAbout: [
      "System design",
      "Distributed systems",
      "API design",
      "Data platforms",
      "AI integration",
      "Technical leadership",
    ],
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Maurizio Turatti, technical strategy, system design, software architecture, architectural decisions, CTO advisory, technical due diligence, distributed systems, API design, AI integration, product architecture, delivery guidance"
    />
  </Fragment>

  <header class="hero hero--about grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">About</div>
      <h1><em>Decisions</em> made before certainty</h1>
      <div class="hero-about-flex">
        <div class="hero-about-photo">
          <img
            src="/images/maurizio.webp"
            alt="Maurizio Turatti"
            width="200"
            height="200"
            loading="eager"
          />
        </div>
        <div class="hero-about-text">
          <p>
            I have been working with software since 1998, building distributed
            systems, integrations, and content platforms for organizations that
            needed the architecture to hold under operational pressure, from
            early-stage startups to established teams scaling up.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Background</h2>
      </div>
      <p>
        My early work was in real-time distributed systems and 3D visualization.
        I moved through SOA and enterprise integration at SeeBeyond and Sun
        Microsystems, then into content platforms at AKQA and Alfresco. I
        co-founded SoftInstigate in 2014 and spent the following years building
        and operating backend systems in production.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Skills</h2>
      </div>
      <div class="link-list skills-list">
        <div class="link-row">
          <div class="name">System design</div>
          <div class="desc">Architecture that holds under operational pressure, not just on diagrams</div>
        </div>
        <div class="link-row">
          <div class="name">Distributed systems</div>
          <div class="desc">Building systems that work across networks, services, and failure modes</div>
        </div>
        <div class="link-row">
          <div class="name">API design</div>
          <div class="desc">Creating interfaces that teams can depend on and evolve without breaking</div>
        </div>
        <div class="link-row">
          <div class="name">Data platforms</div>
          <div class="desc">Managing data at scale with consistency and performance under load</div>
        </div>
        <div class="link-row">
          <div class="name">AI integration</div>
          <div class="desc">Making AI work within existing architectures, not as a separate layer</div>
        </div>
        <div class="link-row">
          <div class="name">Technical leadership</div>
          <div class="desc">Guiding teams through complex decisions with incomplete information</div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Products</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name"><a href="https://restheart.org/">RESTHeart</a></div>
          <div class="desc">The open source backend for MongoDB</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://cloud.restheart.com">RESTHeart Cloud Platform</a>
          </div>
          <div class="desc">
            Managed RESTHeart services with built-in MCP server
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Open source</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/facet">Facet</a>
          </div>
          <div class="desc">
            Data-driven web framework: turn APIs into HTML, zero code
          </div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/ermes-mail">Ermes Mail</a>
          </div>
          <div class="desc">Async e-mail library and CLI for Java</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/restheart-cli"
              >RESTHeart CLI</a
            >
          </div>
          <div class="desc">Command-line interface for RESTHeart</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/mkjsix">All projects on GitHub &rarr;</a
            >
          </div>
          <div class="desc"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Teaching</h2>
      </div>
      <p>
        I created and delivered technical courses and workshops for enterprise
        clients and partner networks across Italy and EMEA. Teaching forces me
        to explain why decisions are made, and that sharpens judgment in the
        work itself.
      </p>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section>
        <div class="wrap">
          <div class="section-label">
            <div class="rule" />
            <h2>Latest writing</h2>
          </div>
          <div class="article-list">
            {posts.map((post) => (
              <div class="article-row">
                <span class="cat">{post.data.tags[0] ?? "Article"}</span>
                <a href={postPath(post.id)}>{post.data.title}</a>
                <span class="date">{formatDate(post.data.date)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Get in touch</h2>
      </div>
      <ContactCta
        title="Thirty minutes to describe the situation and work out whether I am the right person for it."
        subtext="After the call, we decide whether the problem is a fit and what the next step should be."
      />
    </div>
  </section>
</Base>
