---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "Software architect, product engineer, and company co-founder. A career that bridges hands-on development with business leadership. From writing proposals and scoping architecture to shipping code and running production systems.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Software Architect, Product Engineer, and Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Università degli Studi di Milano",
    },
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="Software architect, product engineer, and company co-founder. A career that bridges hands-on development with business leadership. From writing proposals and scoping architecture to shipping code and running production systems."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/Maurizio_Turatti_CV.md" title="Maurizio Turatti CV (Markdown)" />
    <meta name="keywords" content="Maurizio Turatti CV, software architect CV, technical advisor CV, architecture consultant CV" />
  </Fragment>
  <div class="hero hero--first">
    <p class="hero-eyebrow">About</p>
    <h1 class="hero-headline">Building the business and the systems.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          I have always owned both sides of a client engagement: the technical solution and the commercial relationship. Hands-on architecture combined with business development and product strategy. That mix is what I bring to CTO advisory and technical leadership engagements.
        </p>
        <p>
          25+ years in the industry. Co-founder of <a href="https://softinstigate.com" target="_blank" rel="noopener"
            >SoftInstigate</a
          > and creator of <a href="https://restheart.org" target="_blank" rel="noopener">RESTHeart</a>, an open-source platform that turns MongoDB into REST, GraphQL, and WebSocket APIs with built-in security and a native MCP server for AI agents.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:16px;">
          <a href="/Maurizio_Turatti_CV.md" download="Maurizio_Turatti_CV.md" class="cta-btn cta-btn--primary">Download CV (Markdown)</a>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-text">
              Technical Architect for a global luxury brand's e-commerce platform in
              China. Coordinated distributed engineering teams across Berlin,
              Geneva, and Shanghai.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Stabilization of a high-volume production backend serving 2,600+ stores and 9,500+
              terminals: 141M+ documents, 1TB+ data. Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; public sector</p>
            <p class="card-text">
              Traffic data platform (GART) for ACI group, integrating 6+ national
              sources (CCISS, DATEX II, ASPI, TMC). 18 microservices on AWS,
              10,000+ events/day. Serving HERE, TomTom, Radio24. In production
              since 2017 with 99.9% uptime.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-text">
              Architectural discovery and operational roadmap for a public-sector
              compliance platform: 400K+ entities, 9M+ API calls/hour at peak.
              Bottleneck identification across caching, database separation, and
              scalability.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-text">
              RESTHeart integrated as core persistence and API layer for Crownpeak
              Content-as-a-Service, deployed on Kubernetes to thousands of enterprise
              clients globally across Europe and North America.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 2M+ open-source downloads, 10+ years in production.
              Agent-ready platform exposing MongoDB via REST, GraphQL, and
              WebSocket APIs with built-in security and MCP server for AI agents.
              Adopted by Fortune 500 companies.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Career</h2>
      <div class="section-body section-body--spacious">
        <p>
          <strong>SoftInstigate</strong>, Co-Founder &amp; Head of Delivery
          (2014 – present)<br />
          Co-founded the company in 2014. Led both the engineering delivery and the commercial side: business development, client relationships, pre-sales, proposal writing, and commercial partnerships. Product development and advisory across automotive, retail, mobility, and public sector. Owned the full chain from first client conversation to production operations.
        </p>
        <ul>
          <li>Co-created <a href="https://restheart.org" target="_blank" rel="noopener">RESTHeart</a>, growing it from concept to 2M+ downloads and Fortune 500 adoption over 10+ years</li>
          <li>Designed and delivered GART (ACI group): 6+ national sources, 18 microservices on AWS, 10,000+ events/day, in production since 2017 with 99.9% uptime</li>
          <li>Led backend modernization for a retail platform: throughput target exceeded by 79%, query time reduced 216x</li>
        </ul>
        <p>
          <strong>AKQA</strong>, Technical Architect, Berlin (2013 – 2014)<br />
          Technical architect for enterprise digital transformation at a global digital
          agency. Delivered a luxury brand's e-commerce platform in China (Adobe
          Experience Manager), coordinating distributed engineering teams across
          Berlin, Geneva, and Shanghai. Pre-sales technical proposals, architecture
          documentation, and cost estimation for RFPs.
        </p>
        <p>
          <strong>Sourcesense</strong>, Delivery Manager (2011 – 2013)<br />
          Led a consulting team delivering open-source enterprise solutions across
          finance, telecom, and public sector. Combined technical leadership with
          commercial responsibilities.
        </p>
        <p>
          <strong>Alfresco</strong>, Senior Solutions Engineer, Italy (2010 –
          2011)<br />
          Supported the launch of Alfresco's Italian market operations. Pre-sales
          consulting and technical engagements for enterprise content management.
        </p>
        <p>
          <strong>Earlier career (1997 – 2010)</strong><br />
          Progressive career across enterprise integration, distributed systems, and
          software research: SOA architect at Sun Microsystems for Italy and
          the EMEA region, SOA/EAI consulting at SeeBeyond (ICAN and Java CAPS
          platforms), founding an independent consulting practice as official
          partner for Sun Microsystems, delivering Java CAPS and Open ESB projects
          across EMEA, and research in computational geometry and machine
          learning at the Università degli Studi di Milano.
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Open source</h2>
      <div class="section-body">
        <p>
          <a
            href="https://github.com/SoftInstigate/restheart"
            target="_blank"
            rel="noopener"><strong>RESTHeart</strong></a
          >: The agent-ready backend for MongoDB (Java, GraalVM)<br />
          <a
            href="https://github.com/SoftInstigate/facet"
            target="_blank"
            rel="noopener"><strong>Facet</strong></a
          >: Data-driven web framework: turn APIs into HTML, zero code<br />
          <a
            href="https://github.com/SoftInstigate/ermes-mail"
            target="_blank"
            rel="noopener"><strong>Ermes Mail</strong></a
          >: Async e-mail library and CLI for Java<br />
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener"
            >All projects on GitHub →</a
          >
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Writing</h2>
      <div class="section-body">
        <p>
          <a href="/writing/the-system-is-working"
            ><strong>The system is working. That is the problem.</strong></a
          >
          (Jun 2026)<br />
          <a
            href="https://medium.com/softinstigate-team/facet-a-different-approach-to-web-development-af884abe0b69"
            target="_blank"
            rel="noopener"
            ><strong>Facet: A Different Approach to Web Development</strong></a
          >
          (Jan 2026)<br />
          <a
            href="https://medium.com/softinstigate-team/mongodb-deprecates-data-api-and-https-endpoints-how-restheart-can-help-58ea0c44660d"
            target="_blank"
            rel="noopener"
            ><strong>MongoDB Deprecates Data API: How RESTHeart Can Help</strong></a
          >
          (Feb 2025)
        </p>
      </div>
    </div>
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
