---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://maurizioturatti.com/about/#profile",
  url: "https://maurizioturatti.com/about/",
  name: "About Maurizio Turatti",
  description:
    "System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production.",
  mainEntity: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
    jobTitle: "Technical and Commercial Advisor, Company Co-Founder",
    worksFor: {
      "@type": "Organization",
      name: "SoftInstigate",
      url: "https://restheart.org",
    },
    alumniOf: {
      "@type": "EducationalOrganization",
      name: "Universita degli Studi di Milano",
    },
  },
};
---

<Base
  title="About - Maurizio Turatti"
  description="System design, delivery, and technical judgment under uncertainty. Architecture decisions that shape what gets built and what survives in production."
  ogImage="/images/og-image.png"
  jsonLd={aboutJsonLd}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Maurizio Turatti, technical strategy, system design, software architecture, architectural decisions, technical strategy, CTO advisory, technical due diligence, distributed systems, API design, AI integration, product architecture, delivery guidance"
    />
  </Fragment>

  <header class="hero hero--about grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">About</div>
      <h1>Decisions made before certainty.</h1>
      <div class="hero-about-flex">
        <div class="hero-about-photo">
          <img
            src="/images/maurizio.webp"
            alt="Maurizio Turatti"
            width="200"
            height="200"
            loading="eager"
          />
        </div>
        <div class="hero-about-text">
          <p>
            I have been working with software since 1998, building distributed
            systems, integrations, and content platforms for organizations that
            needed the architecture to hold under operational pressure.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <span class="tag">SEC. A</span>
        <div class="rule"></div>
        <h2>Background</h2>
      </div>
      <p>
        My early work was in real-time distributed systems and 3D visualization.
        I moved through SOA and enterprise integration at SeeBeyond and Sun
        Microsystems, then into content platforms at AKQA and Alfresco. I
        co-founded SoftInstigate in 2014 and spent the following years building
        and operating backend systems in production.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-label">
        <span class="tag">SEC. B</span>
        <div class="rule"></div>
        <h2>How I work</h2>
      </div>
      <div class="prose">
        <p>
          Most problems I have seen come from unmanaged complexity and a lack of
          architectural decisions. I keep the design simple, and I push back
          when it is not.
        </p>
      </div>
      <div class="work-grid">
        <div class="work-item">
          <span class="category">Commercial and technical together</span>
          <h3>The important decisions are made together</h3>
          <p>
            Commercial and technical choices are linked. A pricing decision that
            ignores platform complexity creates delivery pressure. A technical
            decision made without commercial constraints creates delivery risk,
            and it usually appears at the worst moment.
          </p>
        </div>
        <div class="work-item">
          <span class="category">Integration across organizations</span>
          <h3>The system boundary is part of the design</h3>
          <p>
            When two organizations have to work together, the architecture is
            not only the code. The boundary defines what each side owns, what is
            shared, and what breaks when the assumptions change.
          </p>
        </div>
        <div class="work-item">
          <span class="category">Decisions under uncertainty</span>
          <h3>Most important choices are made before the facts are complete</h3>
          <p>
            Important decisions are often made with incomplete information. When
            the cost of a wrong call shows up in the contract, the roadmap, or
            the system design, judgment matters more than analysis volume.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <span class="tag">SEC. C</span>
        <div class="rule"></div>
        <h2>AI adoption and architecture</h2>
      </div>
      <p>
        In the last few years, AI has changed how software gets built. AI
        amplifies the quality of existing practices, for better and for worse. I
        work in AI-assisted mode, guided by detailed specifications and rigorous
        testing and refactoring. I help teams introduce AI into their products
        and workflows in a controlled way.
      </p>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <span class="tag">SEC. D</span>
        <div class="rule"></div>
        <h2>Products</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name"><a href="https://restheart.org/">RESTHeart</a></div>
          <div class="desc">The open source backend for MongoDB</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://cloud.restheart.com">RESTHeart Cloud Platform</a>
          </div>
          <div class="desc">
            Managed RESTHeart services with built-in MCP server
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <span class="tag">SEC. E</span>
        <div class="rule"></div>
        <h2>Open source</h2>
      </div>
      <div class="link-list">
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/facet">Facet</a>
          </div>
          <div class="desc">
            Data-driven web framework: turn APIs into HTML, zero code
          </div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/ermes-mail">Ermes Mail</a>
          </div>
          <div class="desc">Async e-mail library and CLI for Java</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/SoftInstigate/restheart-cli"
              >RESTHeart CLI</a
            >
          </div>
          <div class="desc">Command-line interface for RESTHeart</div>
        </div>
        <div class="link-row">
          <div class="name">
            <a href="https://github.com/mkjsix">All projects on GitHub &rarr;</a
            >
          </div>
          <div class="desc"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap prose">
      <div class="section-label">
        <span class="tag">SEC. F</span>
        <div class="rule"></div>
        <h2>Teaching</h2>
      </div>
      <p>
        I created and delivered technical courses and workshops for enterprise
        clients and partner networks across Italy and EMEA. Teaching forces me
        to explain why decisions are made, and that sharpens judgment in the
        work itself.
      </p>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section>
        <div class="wrap">
          <div class="section-label">
            <span class="tag">SEC. G</span>
            <div class="rule" />
            <h2>Latest writing</h2>
          </div>
          <div class="article-list">
            {posts.map((post) => (
              <div class="article-row">
                <span class="cat">{post.data.tags[0] ?? "Article"}</span>
                <a href={postPath(post.id)}>{post.data.title}</a>
                <span class="date">{formatDate(post.data.date)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
