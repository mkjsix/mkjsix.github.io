---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\/index$/, "")}`;

const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://maurizioturatti.com/writing/#blog",
  url: "https://maurizioturatti.com/writing/",
  name: "Writing by Maurizio Turatti",
  description:
    "Notes on architecture, complexity, and the decisions that shape software.",
  inLanguage: "en",
};

const mediumLinks = [
  {
    title: "Facet: A Different Approach to Web Development",
    url: "https://medium.com/softinstigate-team/facet-a-different-approach-to-web-development-af884abe0b69",
    date: "Jan 2026",
    tag: "Frontend",
  },
  {
    title:
      "Splitting User Stories and Product Planning with the Cake and Hamburger Models",
    url: "https://medium.com/@mkj6/splitting-user-stories-and-product-planning-with-the-cake-and-hamburger-models-5e757fe7547c",
    date: "Jan 2026",
    tag: "Process",
  },
  {
    title: "The European Startups Narrative is Broken",
    url: "https://medium.com/@mkj6/the-european-startups-narrative-is-broken-e11f64f0342f",
    date: "Jan 2026",
    tag: "Business",
  },
  {
    title: "What is RESTHeart?",
    url: "https://medium.com/softinstigate-team/what-is-restheart-02043f0f05a8",
    date: "Oct 2025",
    tag: "Backend",
  },
  {
    title:
      "RESTHeart Cloud Examples: A Multi-Framework Reference Implementation",
    url: "https://medium.com/softinstigate-team/restheart-cloud-examples-a-multi-framework-reference-implementation-ec1b3b440c8b",
    date: "Oct 2025",
    tag: "Backend",
  },
  {
    title: "Introducing RESTHeart's Permission System",
    url: "https://medium.com/softinstigate-team/introducing-resthearts-permission-system-cc7016ace9ec",
    date: "Oct 2025",
    tag: "Backend",
  },
  {
    title:
      "MongoDB Deprecates Data API and HTTPS Endpoints: How RESTHeart Can Help",
    url: "https://medium.com/softinstigate-team/mongodb-deprecates-data-api-and-https-endpoints-how-restheart-can-help-58ea0c44660d",
    date: "Feb 2025",
    tag: "Backend",
  },
  {
    title: "RESTHeart with FerretDB: a tutorial",
    url: "https://medium.com/softinstigate-team/restheart-with-ferretdb-a-tutorial-1b43432ed2e0",
    date: "Oct 2023",
    tag: "Backend",
  },
  {
    title: "The origins of our product",
    url: "https://medium.com/softinstigate-team/the-origins-of-our-product-9ed6978c9448",
    date: "Jun 2019",
    tag: "Backend",
  },
  {
    title: "RESTful API memo: PUT and POST verbs",
    url: "https://medium.com/softinstigate-team/restful-api-memo-put-and-post-verbs-1351ffabc359",
    date: "Jan 2018",
    tag: "Backend",
  },
  {
    title: "Do most programmers hate Scrum?",
    url: "https://medium.com/softinstigate-team/do-most-programmers-hate-agile-274079ddb0d9",
    date: "Jun 2017",
    tag: "Process",
  },
];
---

<Base
  title="Writing - Maurizio Turatti"
  description="Notes on architecture, complexity, and the decisions that shape software."
  ogImage="/images/og-image.png"
  jsonLd={blogJsonLd}
>
  <style>
    :root { --max-width: 820px; }
    .section-label h2 { font-size: 1.6rem; }
    section { padding: 50px 0; }
    .section-label { margin-bottom: 32px; }
  </style>

  <header class="hero hero--writing grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">Writing</div>
      <h1>Practical notes from the architecture trenches.</h1>
      <p>Thoughts on architecture, systems and engineering.</p>
    </div>
  </header>

  {posts.length > 0 && (
    <section>
      <div class="wrap">
        <div class="section-label">
          <span class="section-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M13.5 3.5l3 3L7 16H4v-3L13.5 3.5z"/></svg></span>
          <div class="rule"></div>
          <h2>On this site</h2>
        </div>
        <div class="article-list">
          {posts.map((post) => (
            <div class="article-row">
              <span class="cat">{post.data.tags[0] ?? 'Article'}</span>
              <a href={postPath(post.id)}>{post.data.title}</a>
              <span class="date">{formatDate(post.data.date)}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="section-label">
        <span class="section-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 3h10a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/><path d="M7 10l2 2 4-4"/></svg></span>
        <div class="rule"></div>
        <h2>On Medium</h2>
      </div>
      <div class="article-list">
        {mediumLinks.map((link) => (
          <div class="article-row external">
            <span class="cat">{link.tag}</span>
            <a href={link.url} target="_blank" rel="noopener">{link.title}</a>
            <span class="date">{link.date}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
