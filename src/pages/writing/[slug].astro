---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} — Maurizio Turatti`} description={post.data.description}>
  {post.data.canonical_url && (
    <link rel="canonical" href={post.data.canonical_url} slot="head" />
  )}

  <div class="hero hero--first">
    <p class="hero-eyebrow">
      {formatDate(post.data.date)}
      {post.data.tags.length > 0 && <> &middot; {post.data.tags.join(', ')}</>}
    </p>
    <h1 class="hero-headline">{post.data.title}</h1>
  </div>
  <hr class="section-separator" />

  <div class="page-content post-content">
    <Content />
  </div>

  <div style="padding-bottom: 48px;">
    <a href="/writing" style="font-size: 14px; color: var(--color-text-muted); text-decoration: none;">
      &larr; All posts
    </a>
  </div>
</Base>

<style>
.post-content {
  max-width: 680px;
}
.post-content :global(h2) {
  font-size: 22px;
  font-weight: 500;
  margin: 2rem 0 0.75rem;
  letter-spacing: -0.3px;
}
.post-content :global(h3) {
  font-size: 18px;
  font-weight: 500;
  margin: 1.5rem 0 0.5rem;
}
.post-content :global(p) {
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-text-muted);
  margin-bottom: 1.25rem;
}
.post-content :global(a) {
  color: var(--color-text);
  text-underline-offset: 3px;
}
.post-content :global(code) {
  font-size: 13px;
  background: var(--color-card-bg);
  padding: 2px 6px;
  border-radius: 4px;
}
.post-content :global(pre) {
  background: var(--color-card-bg);
  padding: 1.25rem;
  border-radius: var(--radius-lg);
  overflow-x: auto;
  margin-bottom: 1.25rem;
}
.post-content :global(pre code) {
  background: none;
  padding: 0;
  font-size: 13px;
}
.post-content :global(blockquote) {
  border-left: 2px solid var(--color-border-strong);
  padding-left: 1.25rem;
  margin: 1.5rem 0;
  color: var(--color-text-muted);
  font-style: italic;
}
.post-content :global(ul),
.post-content :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1.25rem;
  color: var(--color-text-muted);
}
.post-content :global(li) {
  margin-bottom: 0.4rem;
  font-size: 16px;
  line-height: 1.7;
}
</style>
