---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Product Strategy",
    "Pre-sales",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Technical Decisions that Reduce Risk and Complexity - Maurizio Turatti"
  description="I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Software architecture and technical leadership for products that need to move fast.
    </h1>
    <p class="hero-sub">
      Senior technical leadership with a business edge. Embedded in your team or on call.
    </p>
  </div>

  <div class="section-stack">
    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid">
        <div class="surface-card">
          <p class="card-label">Ongoing technical direction</p>
          <p class="card-text">
            Embedded in your team or on call. Translating business goals into architectural decisions, aligning engineering and stakeholders around a technical direction that supports delivery without accumulating hidden risk.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Architecture assessment &amp; due diligence</p>
          <p class="card-text">
            System design reviews that identify root causes and surface where the real constraints are. Performance, security, and scalability evaluation. Independent technical assessment for production readiness, vendor evaluation, or investment decisions.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Technical strategy with commercial perspective</p>
          <p class="card-text">
            Pre-sales, proposals, and client engagement informed by deep technical understanding. Product roadmap and go-to-market for technical products. Built on years of owning both the delivery and the commercial relationship.
          </p>
        </div> 
      </div>
    </div>

    <!-- How it works -->
    <div class="section-block">
      <div class="section-body">
        <p>
          My decisions come from operating real systems in production, including how AI integrates into existing architectures. Good architecture becomes more valuable when AI enters the picture, because the quality of the underlying structure determines how much value AI can deliver. Every engagement combines this direct experience with commercial understanding. <a href="/about">Full background →</a>
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Modernization of a high-volume production backend:
              2,600+ stores, 9,500+ terminals, 141M+ documents, 1TB+ data.
              Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-text">
              GART: real-time traffic data platform, 6+ national sources
              (CCISS, DATEX II, ASPI, TMC), 18 microservices on AWS,
              10,000+ events/day, 99.9% uptime. Serving HERE, TomTom, Radio24.
              In production since 2017.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 2M+ open-source downloads, 10+ years in production. Agent-ready backend for MongoDB,
              adopted by Fortune 500 companies including Unisys, Northrop Grumman, and Crownpeak.
            </p>
          </div>
        </div>
        <p style="margin-top: 16px;">
          <a href="/about">All selected work →</a>
        </p>
      </div>
    </div>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">Latest writing</h2>
        <div class="blog-list">
          {posts.map((post, index) => (
            <>
              <a href={postPath(post.id)} class="blog-item">
                <span class="blog-title">{post.data.title}</span>
                <span class="blog-meta">
                  {post.data.tags[0] && (
                    <span class="blog-tag">{post.data.tags[0]}</span>
                  )}
                  <span class="blog-date">{formatDate(post.data.date)}</span>
                </span>
              </a>
              {index < posts.length - 1 && (
                <hr class="section-separator blog-separator" />
              )}
            </>
          ))}
        </div>
        <p class="section-body" style="margin-top: 16px;">
          <a href="/writing">All writing →</a>
        </p>
      </div>
    )}
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
