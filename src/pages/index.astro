---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Software architect, product engineer, and company co-founder. Technical leadership that bridges engineering and business: CTO advisory, architecture reviews, and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Product Strategy",
    "Pre-sales",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Software Architecture and Technical Leadership — Maurizio Turatti"
  description="Software architect, product engineer, and company co-founder. Technical leadership that bridges engineering and business: CTO advisory, architecture reviews, and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Software architecture and technical leadership for products that need to move fast.
    </h1>
    <p class="hero-sub">
      Senior technical leadership with a business edge. Embedded in your team or on call.
    </p>
  </div>

  <div class="section-stack">
    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">What I do</h2>
      <div class="card-grid">
        <div class="surface-card">
          <p class="card-label">CTO advisory &amp; technical leadership</p>
          <p class="card-text">
            Ongoing technical leadership and strategic guidance, embedded in your team or on call. Translating business goals into technical direction, bridging engineering teams and business stakeholders through the full product lifecycle.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Architecture review &amp; technical due diligence</p>
          <p class="card-text">
            System design reviews, performance and security optimization, cloud migration planning. Independent technical evaluation: vendor assessment, production readiness, requirements for tenders. Fixed scope, clear objectives.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Business &amp; product strategy</p>
          <p class="card-text">
            Pre-sales, commercial proposals, and client engagement from first conversation to contract. Product roadmap and go-to-market for technical products. Built from running a consulting and product company.
          </p>
        </div>
      </div>
    </div>

    <!-- Credibility snippet -->
    <div class="section-block">
      <div class="section-body">
        <p>
          Co-founder of <strong>SoftInstigate</strong> and creator of <a href="https://restheart.org" target="_blank" rel="noopener">RESTHeart</a>,
          an agent-ready platform that exposes MongoDB through REST, GraphQL, and WebSocket APIs with built-in security and a native MCP server for AI agents. I have built a consulting and product business from the ground up. Former SOA architect at <strong>Sun Microsystems</strong> (EMEA) and technical architect at <strong>AKQA</strong> Berlin. <a href="/about">Full background →</a>
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Technical lead for modernization of a high-volume production backend:
              2,600+ stores, 9,500+ terminals, 141M+ documents, 1TB+ data.
              Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-text">
              GART: real-time traffic data platform, 6+ national sources
              (CCISS, DATEX II, ASPI, TMC), 18 microservices on AWS,
              10,000+ events/day, 99.9% uptime. Serving HERE, TomTom, Radio24.
              In production since 2017.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 2M+ open-source downloads, 10+ years in production. Agent-ready backend for MongoDB,
              adopted by Fortune 500 companies including Unisys, Northrop Grumman, and Crownpeak.
            </p>
          </div>
        </div>
        <p style="margin-top: 16px;">
          <a href="/about">All selected work →</a>
        </p>
      </div>
    </div>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">Latest writing</h2>
        <div class="blog-list">
          {posts.map((post, index) => (
            <>
              <a href={postPath(post.id)} class="blog-item">
                <span class="blog-title">{post.data.title}</span>
                <span class="blog-meta">
                  {post.data.tags[0] && (
                    <span class="blog-tag">{post.data.tags[0]}</span>
                  )}
                  <span class="blog-date">{formatDate(post.data.date)}</span>
                </span>
              </a>
              {index < posts.length - 1 && (
                <hr class="section-separator blog-separator" />
              )}
            </>
          ))}
        </div>
        <p class="section-body" style="margin-top: 16px;">
          <a href="/writing">All writing →</a>
        </p>
      </div>
    )}
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
