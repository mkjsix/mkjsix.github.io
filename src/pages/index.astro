---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Technical decisions that are hard to reverse. Architecture guidance for MVP delivery, modernization, and cross-organization integration.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Lead Evaluation",
    "Product Strategy",
    "Public Sector Tender Assessment",
    "Private Sector Tender Assessment",
    "Feasibility Analysis",
    "Partnership Structuring",
    "Partner Management",
    "Vendor Management",
    "Contract Negotiation",
    "Pre-Sales Technical Framing",
    "RFP Response Management",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "Client-Facing Delivery",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="Technical decisions that are hard to reverse. Architecture guidance for MVP delivery, modernization, and cross-organization integration."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Technical decisions that are hard to reverse.
    </h1>
    <p class="hero-sub">
      What is feasible, where to commit, and which risks will surface after delivery.
    </p>
  </div>

  <div class="section-stack">
    <!-- How I help -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid card-grid--featured card-grid--how-i-help">
        <div class="surface-card">
          <p class="card-title">MVP and technical direction</p>
          <p class="card-label">
            &ldquo;I need a senior technical guide through delivery, including AI.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">A system in production that is not holding</p>
          <p class="card-label">
            &ldquo;I need to know whether the system will hold under real load and what must change before it breaks.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Integration across different organizations</p>
          <p class="card-label">
            &ldquo;I need a system boundary that lets two organizations work together without locking us into brittle integration.&rdquo;
          </p>
        </div>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid card-grid--featured card-grid--selected-work">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-title">
              Replacing a backend without stopping 2,600 stores
            </p>
            <p class="card-text">
              The key decision was to replace the backend in place without
              interrupting operations across 2,600 stores and 9,500 terminals.
              No downtime was acceptable. The migration kept the risk visible,
              safeguarded the data model, and delivered a 79% throughput gain and
              a 216x query-time reduction.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-title">One architecture across three cities</p>
            <p class="card-text">
              The decision was to build one shared architecture that could serve
              a luxury brand across Berlin, Geneva, and Shanghai while meeting
              local compliance and localization constraints. The structure kept
              the teams aligned across time zones and preserved delivery momentum.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-title">18 microservices on AWS</p>
            <p class="card-text">
              The decision was to absorb multiple national traffic feeds with
              different schemas and update cycles, without forcing a fragile
              single-source model. That choice kept daily consumers reliable and
              the platform available at 99.9% uptime.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-title">
              Architecture while requirements were still moving
            </p>
            <p class="card-text">
              The decision was to keep architecture moving while requirements
              were still forming, and to optimize the bottlenecks before a wider
              modular redesign. That kept the project on track through high
              traffic and a changing demand picture.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-title">Headless CMS for Content as a Service</p>
            <p class="card-text">
              The decision was to keep a single API contract while many clients
              depended on the same content layer. That separation made the system
              reusable without forcing each client into bespoke integration.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-title">Ten years of evolution without rewrite</p>
            <p class="card-text">
              The decision was to evolve the platform over time rather than
              rewrite it around major upstream changes. That preserved product
              continuity while the platform grew into a hosted SaaS offering.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Latest writing -->
    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
