---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Product Strategy",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Technical leadership with a business edge.
    </h1>
    <p class="hero-sub">
      Software architecture for products that need to move fast.
    </p>
  </div>

  <div class="section-stack">
    <!-- How I help -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid card-grid--featured card-grid--how-i-help">
        <div class="surface-card">
          <p class="card-title">Losing direction</p>
          <p class="card-label">
            &ldquo;We are building fast, but I cannot tell if we are going in
            the right direction.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Scaling risk</p>
          <p class="card-label">
            &ldquo;We need to scale and I don&rsquo;t know if the architecture
            will hold.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Non-technical decisions</p>
          <p class="card-label">
            &ldquo;I am non-technical and I need to make decisions about a team
            or a provider.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Independent technical review</p>
          <p class="card-label">
            &ldquo;We need an independent technical opinion on what we are
            building.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Hidden tech debt</p>
          <p class="card-label">
            &ldquo;I don&rsquo;t know if the product is accumulating tech
            debt.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Rewrite or continue?</p>
          <p class="card-label">
            &ldquo;Should we keep building on what we have or start over?&rdquo;
          </p>
        </div>
      </div>
    </div>

    <!-- How it works -->
    <div class="section-block">
      <div class="section-body">
        <p>
          My recommendations come from over two decades of building systems and
          living with the consequences of those decisions. Technical and
          commercial considerations shape each other from the start. <a
            href="/about">How I think →</a
          >
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid card-grid--featured card-grid--selected-work">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-title">
              Replacing a backend without stopping 2,600 stores
            </p>
            <p class="card-text">
              Replacing the backend without stopping 2,600+ stores and 9,500+
              terminals. No downtime allowed. A wrong data migration would have
              been visible in every store the next morning. 150M+ documents,
              1TB+ data. Throughput target exceeded by 79%, query time reduced
              216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-title">One architecture across three cities</p>
            <p class="card-text">
              Distributed teams in Berlin, Geneva, and Shanghai building a
              luxury brand's e-commerce platform for China. Localization in
              Chinese and compliance with Chinese authority security
              requirements. Architectural decisions coordinated across three
              time zones.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-title">
              Traffic data with no single source of truth
            </p>
            <p class="card-text">
              Multiple national traffic sources, each with a different schema
              and update cycle. No single source of truth, and consumers relying
              on the output daily. 18 microservices on AWS, 10,000+ events/day,
              99.9% uptime. Serving HERE, TomTom, Radio24. In production since
              2017.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-title">
              Architecture while requirements were still moving
            </p>
            <p class="card-text">
              400K+ entities, 9M+ API calls/hour at peak. Requirements still
              forming while the architecture needed to proceed. Optimizing Redis
              to relieve database pressure and building a roadmap toward modular
              architecture.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-title">Headless CMS for Content as a Service</p>
            <p class="card-text">
              Persistence and API layer for Crownpeak headless CMS, built for a
              Content as a Service model used by hundreds of Crownpeak clients
              worldwide. One API contract, many clients depending on it.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-title">Ten years of evolution without rewrite</p>
            <p class="card-text">
              RESTHeart: 10+ years in production, evolved without a rewrite
              across major versions and breaking upstream changes. Adopted by
              Unisys, Northrop Grumman, and Crownpeak. Built and shipped <a href="https://cloud.restheart.com">RESTHeart Cloud</a>, a hosted SaaS version.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Latest writing -->
    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
