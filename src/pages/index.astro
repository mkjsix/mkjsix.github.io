---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Product Strategy",
    "Pre-sales",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Software architecture and technical leadership for products that need to
      move fast.
    </h1>
    <p class="hero-sub">Technical leadership with a business edge.</p>
  </div>

  <div class="section-stack">
    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid">
        <div class="surface-card">
          <p class="card-label">Embedded technical leadership</p>
          <p class="card-text">
            Embedded in your team or on call. Making architectural decisions
            that hold up when the system needs to grow. The most important skill
            is knowing what not to build.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Architecture assessment &amp; due diligence</p>
          <p class="card-text">
            Not just performance and security, but the decisions underneath.
            Independent assessment before an acquisition, a major investment, or
            a scaling problem. I have done this enough times to know that the
            real risks are rarely the obvious ones.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">
            Pre-sales and product direction with technical depth
          </p>
          <p class="card-text">
            A wrong assumption in a proposal becomes a problem in delivery. I
            have worked both sides of that, and it shapes how I approach
            proposals, pre-sales, and product direction.
          </p>
        </div>
      </div>
    </div>

    <!-- How it works -->
    <div class="section-block">
      <div class="section-body">
        <p>
          My recommendations come from building systems, running projects, and
          dealing with the consequences of those decisions. The technical and
          the commercial are not separate conversations.<br /><a href="/about"
            >Full background →</a
          >
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Replacing the backend without stopping 2,600+ stores and 9,500+
              terminals. 141M+ documents, 1TB+ data. The system could not go
              dark. Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-text">
              6+ national traffic sources, each with a different schema and
              update cycle. 18 microservices on AWS, 10,000+ events/day, 99.9%
              uptime. The hard part was not the volume. It was making
              incompatible sources look like one coherent dataset. Serving HERE,
              TomTom, Radio24. In production since 2017.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: built it, maintained it, dealt with production problems
              for 10+ years. 2M+ downloads. Adopted by Unisys, Northrop Grumman,
              and Crownpeak. You learn a lot about architectural trade-offs when
              you have to live with them.
            </p>
          </div>
        </div>
        <p style="margin-top: 16px;">
          <a href="/about">All selected work →</a>
        </p>
      </div>
    </div>

    <!-- Latest writing -->
    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
