---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ContactCta from "../components/ContactCta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I work with founders, CIOs, CTOs and boards focused on architecture, system design, and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Technical Assessment",
    "Legacy System Modernization",
    "Java",
    "AWS",
    "MongoDB",
  ],
};
---

<Base
  title="Maurizio Turatti | Architectural discipline for AI-assisted development"
  description="I work with founders, CIOs, CTOs and boards focused on architecture, system design, and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <header class="hero grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">
        Software architecture &middot; System design
      </div>
      <h1>Architectural discipline<br />for <em>AI-assisted development</em></h1>
      <p>
        I work with founders, CIOs, CTOs &amp; boards focused on architecture,
        system design, and technical due diligence.
      </p>
      <div class="actions">
        <a
          href="https://calendly.com/maurizioturatti-info/30min"
          class="btn"
          data-calendly>Book a call</a
        >
        <a href="#work" class="link">Selected work</a>
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>AI-assisted development</h2>
      </div>
      <div class="ai-grid">
        <div class="prose">
          <p>
            I approach agentic development through the discipline of Lean
            engineering: clear value streams, bounded roles, and continuous
            refactoring.
          </p>
          <p>
            Agents need explicit job descriptions and hard guardrails. The workflow
            operates as a pull system: well-specified tasks wait on a board, where
            dedicated agents pull work within their scope, implement changes, and
            validate them against tests.
          </p>
          <p>
            Without that structure, agents simply generate more code than anyone
            can review.
          </p>
        </div>
        <svg class="ai-visual" viewBox="0 0 260 200" fill="none" aria-hidden="true">
          <defs>
            <marker id="ai-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 0L8 4L0 8z" fill="var(--text-muted)"></path>
            </marker>
          </defs>
          <rect x="86" y="12" width="88" height="44" rx="3" stroke="var(--accent)" stroke-width="2"></rect>
          <circle cx="130" cy="34" r="10" stroke="var(--accent)" stroke-width="1.4"></circle>
          <path d="M125 34L129 38L136 30" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M100 56L42 137" stroke="var(--text-muted)" stroke-width="1.2" marker-end="url(#ai-arrow)"></path>
          <path d="M124 56V129" stroke="var(--text-muted)" stroke-width="1.2" marker-end="url(#ai-arrow)"></path>
          <path d="M160 56L218 137" stroke="var(--text-muted)" stroke-width="1.2" marker-end="url(#ai-arrow)"></path>
          <path d="M54 140L112 59" stroke="var(--text-muted)" stroke-opacity=".6" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#ai-arrow)"></path>
          <path d="M136 132V59" stroke="var(--text-muted)" stroke-opacity=".6" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#ai-arrow)"></path>
          <path d="M206 140L148 59" stroke="var(--text-muted)" stroke-opacity=".6" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#ai-arrow)"></path>
          <rect x="24" y="140" width="48" height="28" rx="2" stroke="var(--accent)" stroke-width="1.2"></rect>
          <rect x="100" y="132" width="60" height="40" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
          <rect x="190" y="140" width="44" height="24" rx="2" stroke="var(--accent)" stroke-width="1.1"></rect>
        </svg>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Typical engagements</h2>
      </div>

      <div class="help-list">
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="16" cy="16" r="13"></circle><path
                d="M21 11l-4 8-8 4 4-8 8-4z"></path><circle
                cx="16"
                cy="16"
                r="1.4"
                fill="var(--accent)"
                stroke="none"></circle></svg
            ></span
          >
          <div>
            <span class="category">Build from architecture to production</span>
            <p>
              A founder needs senior technical leadership to design and deliver
              an MVP.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><path d="M4 27h24" stroke-linecap="round"></path><rect
                x="7"
                y="18"
                width="4.5"
                height="9"></rect><rect x="14" y="12" width="4.5" height="15"
              ></rect><rect x="21" y="6" width="4.5" height="21"></rect></svg
            ></span
          >
          <div>
            <span class="category">Scale a system in production</span>
            <p>
              A production system starts to break under growth. Performance,
              security, scalability or infrastructure costs are becoming a
              problem.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="7" cy="9" r="4"></circle><circle
                cx="25"
                cy="23"
                r="4"></circle><path
                d="M10.5 11.5L21.5 20.5"
                stroke-dasharray="2 3"></path></svg
            ></span
          >
          <div>
            <span class="category">Integrate different systems</span>
            <p>
              Systems built by different organizations or with different
              technologies need to be integrated and work together.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><rect x="5" y="5" width="22" height="22" rx="2"></rect><path
                d="M11 16h10M16 11v10"></path></svg
            ></span
          >
          <div>
            <span class="category"
              >Establish or evolve the technical organization</span
            >
            <p>
              A company needs to establish or evolve its technical organization,
              from architecture and engineering practices to pre-sales and
              professional services.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="16" cy="16" r="12"></circle><path d="M16 10v7l5 3"
              ></path></svg
            ></span
          >
          <div>
            <span class="category">Independent assessment</span>
            <p>
              A board, founder or investor needs an independent assessment of
              technical readiness before making a significant investment or
              strategic decision.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Three levels of design</h2>
      </div>

      <div class="steps steps--3">
        <div class="step">
          <svg class="step-visual" viewBox="0 0 240 120" fill="none" aria-hidden="true">
            <rect x="12" y="12" width="76" height="48" rx="4" stroke="var(--text-muted)" stroke-opacity=".55" stroke-dasharray="3 3"></rect>
            <rect x="152" y="12" width="76" height="48" rx="4" stroke="var(--text-muted)" stroke-opacity=".55" stroke-dasharray="3 3"></rect>
            <rect x="82" y="64" width="76" height="48" rx="4" stroke="var(--text-muted)" stroke-opacity=".55" stroke-dasharray="3 3"></rect>
            <rect x="22" y="22" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <rect x="162" y="22" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <rect x="92" y="74" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <path d="M78 36H162M50 50L100 74M190 50L140 74" stroke="var(--text-muted)" stroke-width="1.2"></path>
          </svg>
          <h3>Architecture</h3>
          <p>
            Architecture sets the boundaries between components and the
            patterns that connect them, such as microservices or event-driven
            integration. Once the system is in production, it is the hardest
            part of the design to change.
          </p>
        </div>
        <div class="step">
          <svg class="step-visual" viewBox="0 0 240 120" fill="none" aria-hidden="true">
            <rect x="6" y="6" width="140" height="108" rx="10" stroke="var(--text-muted)" stroke-dasharray="4 3"></rect>
            <rect x="160" y="6" width="74" height="108" rx="2" stroke="var(--text-muted)"></rect>
            <path d="M160 30H234M160 90H234" stroke="var(--line)"></path>
            <text x="14" y="108" fill="var(--text-muted)" font-family="IBM Plex Mono, monospace" font-size="9">cloud</text>
            <text x="166" y="108" fill="var(--text-muted)" font-family="IBM Plex Mono, monospace" font-size="9">on-prem</text>
            <rect x="22" y="22" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <rect x="72" y="66" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <rect x="169" y="46" width="56" height="28" rx="2" stroke="var(--accent)" stroke-width="1.4"></rect>
            <path d="M50 50L92 66M78 36H150V60H169M128 80H150V70H169" stroke="var(--text-muted)" stroke-width="1.2"></path>
          </svg>
          <h3>System design</h3>
          <p>
            System design maps the logical architecture onto a cloud or
            on-premises system, where it meets the constraints of physical
            reality. It decides how the system handles traffic peaks and server
            failures.
          </p>
        </div>
        <div class="step">
          <svg class="step-visual" viewBox="0 0 240 120" fill="none" aria-hidden="true">
            <rect x="40" y="8" width="160" height="104" rx="3" stroke="var(--accent)" stroke-width="1.4"></rect>
            <path d="M40 26H200" stroke="var(--accent)" stroke-width="1"></path>
            <path d="M56 42H136M64 54H156M64 66H120M56 78H144M64 90H108" stroke="var(--text-muted)" stroke-width="1.6" stroke-linecap="round"></path>
            <circle cx="176" cy="92" r="11" stroke="var(--accent)" stroke-width="1.4"></circle>
            <path d="M171 92L175 96L182 88" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <h3>Software design</h3>
          <p>
            Software design is the structure of the code inside each component.
            I write it test-first and refactor it continuously, and every change
            goes through continuous integration. Code written by AI agents goes
            through the same tests before it is merged.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Selected work</h2>
      </div>

      <div class="case-grid">
        <div class="case">
          <div class="stat">
            18<span class="stat-label">services replacing one monolith</span>
          </div>
          <div class="content">
            <span class="category">Mobility &middot; National traffic information</span>
            <h3>Replacing an inherited traffic information system</h3>
            <p>
              The previous system ran on PHP and Oracle, with no documentation,
              no automated tests and its database port open to the internet.
              The replacement has run on AWS since 2017. It polls six traffic
              sources every 3 to 5 minutes and publishes about 10,000 events a
              day in three languages.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            9%<span class="stat-label">average database CPU at 9M API calls per hour</span>
          </div>
          <div class="content">
            <span class="category">Public sector &middot; National compliance register</span>
            <h3>Locating the load on a register of 400,000 business sites</h3>
            <p>
              54% of database waits came from writing a log row for every API
              request: 2 billion rows, 13 TB. Caching token validation cut
              total SQL time by 77% and database CPU by 89% in load tests. I led
              the architecture review and the caching strategy with Redis on top
              of the database.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            216&times;<span class="stat-label">query time, from 325 s to 1.5 s</span>
          </div>
          <div class="content">
            <span class="category">Retail &middot; Fiscal documents</span>
            <h3>Moving 150 million documents off a relational database</h3>
            <p>
              Invoices, orders and EDI documents arrive from more than 200
              channels, with a target of 100,000 files per hour against 6,000
              at the start. The MongoDB architecture sustained 537 writes per
              second, where 300 were required, at 14 ms average latency.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            7,500<span class="stat-label">historical responses used as test cases</span>
          </div>
          <div class="content">
            <span class="category">HR tech &middot; Founder-led product</span>
            <h3>Moving a scoring method out of Excel</h3>
            <p>
              The method lived in a workbook with its algorithms and past
              responses. I rewrote the scoring engine in Java and checked every
              result against the spreadsheet. The web application reached
              production less than three months after the first commit.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            4<span class="stat-label">cities, one architecture</span>
          </div>
          <div class="content">
            <span class="category">Luxury e-commerce</span>
            <h3>One architecture across four cities</h3>
            <p>
              A single shared architecture for a luxury brand: frontend in
              Berlin, backend in Gurgaon, deployment in Shanghai, client in
              Geneva. Local compliance and localization were built into the
              design. It kept teams aligned across time zones.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            2M+<span class="stat-label">Docker pulls of RESTHeart</span>
          </div>
          <div class="content">
            <span class="category">Own products &middot; Open source</span>
            <h3>Products I build and operate</h3>
            <p>
              I co-created <a href="https://restheart.org/">RESTHeart</a>, the
              open source backend for MongoDB, in 2014.{" "}
              <a href="https://cloud.restheart.com/">RESTHeart Cloud</a> and{" "}
              <a href="https://bysophia.ai/">Sophia</a>, a RAG platform, run on
              it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {
    posts.length > 0 && (
      <section>
        <div class="wrap">
          <div class="section-label">
            <div class="rule" />
            <h2>Latest writing</h2>
          </div>

          <div class="article-list">
            {posts.map((post) => (
              <div class="article-row">
                <span class="cat">{post.data.tags[0] ?? "Article"}</span>
                <a href={postPath(post.id)}>{post.data.title}</a>
                <span class="date">{formatDate(post.data.date)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Get in touch</h2>
      </div>
      <ContactCta
        title="Thirty minutes to describe the situation and work out whether I am the right person for it."
        subtext="If you need an NDA before the call, send it with the invitation."
      />
    </div>
  </section>
</Base>
