---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Technical leadership with a business edge. Software architecture and system design for products that need to move fast.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Lead Evaluation",
    "Product Strategy",
    "Public Sector Tender Assessment",
    "Private Sector Tender Assessment",
    "Feasibility Analysis",
    "Partnership Structuring",
    "Partner Management",
    "Vendor Management",
    "Contract Negotiation",
    "Pre-Sales Technical Framing",
    "RFP Response Management",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "Client-Facing Delivery",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="Technical leadership with a business edge. Software architecture and system design for products that need to move fast."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Technical leadership with a business edge
    </h1>
    <p class="hero-sub">Software architecture and system design for products that need to move fast.</p>
  </div>

  <div class="section-stack">
    <!-- How I help -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid card-grid--featured card-grid--how-i-help">
        <div class="surface-card">
          <p class="card-title">MVP and technical direction</p>
          <p class="card-label">
            &ldquo;I need a senior technical guide to design and deliver an MVP,
            including AI from pilot to production.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Scale a system in production</p>
          <p class="card-label">
            &ldquo;I need to know whether the system will hold under real load
            and what has to change before it breaks.&rdquo;
          </p>
        </div>
        <div class="surface-card">
          <p class="card-title">Integration across different organizations</p>
          <p class="card-label">
            &ldquo;I need a clear boundary between our systems, without creating a
            dependency we cannot get out of later.&rdquo;
          </p>
        </div>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid card-grid--featured card-grid--selected-work">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-title">
              Replacing a backend without stopping 2,600 stores
            </p>
            <p class="card-text">
              The constraint was to replace the backend in place while keeping
              2,600 stores and 9,500 terminals running. The migration handled
              150 million documents and 1 TB of data, delivering a 79%
              throughput gain and a 216x query-time reduction.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-title">One architecture across three cities</p>
            <p class="card-text">
              The choice was one shared architecture for a luxury brand across
              Berlin, Geneva, and Shanghai, with local compliance and
              localization constraints built into the design. It kept teams
              aligned across time zones and preserved delivery momentum.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-title">18 microservices on AWS</p>
            <p class="card-text">
              The constraint was multiple national traffic feeds, each with a
              different schema and update cycle. The platform absorbed HERE,
              TomTom, and Radio24 without imposing a single-source model, and
              has run in production since 2017 with more than 99.9% uptime.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-title">
              Architecture while requirements were still moving
            </p>
            <p class="card-text">
              Requirements were still forming, so the architecture had to move
              while the main bottlenecks were being identified. The system grew
              to 400,000 entities and handled peaks of 9 million calls per hour
              before a wider modular redesign.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-title">Headless CMS for Content as a Service</p>
            <p class="card-text">
              The choice was a single API contract for Crownpeak while hundreds
              of clients depended on the same content layer. The separation
              made the system reusable without forcing each client into bespoke
              integration.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-title">Ten years of evolution without rewrite</p>
            <p class="card-text">
              RESTHeart evolved through major upstream changes while preserving
              a stable product and API. Unisys and Northrop Grumman were among
              the organizations using the open source platform as it grew into a
              hosted SaaS offering.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Latest writing -->
    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
