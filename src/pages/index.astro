---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ContactCta from "../components/ContactCta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Technical strategy with a business edge. Software architecture and system design for products that need to move fast.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical strategy",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Lead Evaluation",
    "Product Strategy",
    "Public Sector Tender Assessment",
    "Private Sector Tender Assessment",
    "Feasibility Analysis",
    "Partnership Structuring",
    "Partner Management",
    "Vendor Management",
    "Contract Negotiation",
    "Pre-Sales Technical Framing",
    "RFP Response Management",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "Client-Facing Delivery",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="Technical strategy with a business edge. Software architecture and system design for products that need to move fast."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <header class="hero grid-bg">
    <div class="wrap">
      <div class="eyebrow mono">
        Software architecture &middot; System design
      </div>
      <h1>Technical strategy<br />with a <em>business edge</em></h1>
      <p>
        I work with founders, CTOs &amp; boards through time-boxed engagements
        focused on architecture, production systems, integration, and technical
        due diligence.
      </p>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Typical engagements</h2>
      </div>

      <div class="help-list">
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="16" cy="16" r="13"></circle><path
                d="M21 11l-4 8-8 4 4-8 8-4z"></path><circle
                cx="16"
                cy="16"
                r="1.4"
                fill="var(--accent)"
                stroke="none"></circle></svg
            ></span
          >
          <div>
            <span class="category">Build from architecture to production</span>
            <p>
              A founder needs senior technical leadership to design and deliver
              an MVP, from architecture to production.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><path d="M4 27h24" stroke-linecap="round"></path><rect
                x="7"
                y="18"
                width="4.5"
                height="9"></rect><rect x="14" y="12" width="4.5" height="15"
              ></rect><rect x="21" y="6" width="4.5" height="21"></rect></svg
            ></span
          >
          <div>
            <span class="category">Scale a system in production</span>
            <p>
              A production system starts to break under growth. Performance,
              security, scalability or infrastructure costs are becoming a
              problem.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="7" cy="9" r="4"></circle><circle
                cx="25"
                cy="23"
                r="4"></circle><path
                d="M10.5 11.5L21.5 20.5"
                stroke-dasharray="2 3"></path></svg
            ></span
          >
          <div>
            <span class="category">Integrate different systems</span>
            <p>
              Systems built by different organizations or with different
              technologies need to be integrated and work together.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><rect x="5" y="5" width="22" height="22" rx="2"></rect><path
                d="M11 16h10M16 11v10"></path></svg
            ></span
          >
          <div>
            <span class="category"
              >Establish or evolve the technical organization</span
            >
            <p>
              A company needs to establish or evolve its technical organization,
              from architecture and engineering practices to pre-sales and
              professional services.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="16" cy="16" r="12"></circle><path d="M16 10v7l5 3"
              ></path></svg
            ></span
          >
          <div>
            <span class="category">Independent assessment</span>
            <p>
              A board, founder or investor needs an independent assessment of
              technical readiness before making a significant investment or
              strategic decision.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>How I work</h2>
      </div>
      <div class="prose">
        <p>
          I often end up talking to the business. What I produce is a detailed
          specification: what gets built, in which order, and what is left out
          of the first version.
        </p>
        <p>
          The technology I pick is the one that lets the smallest possible team
          do the most. Fewer technologies means fewer things to keep alive.
        </p>
      </div>
    </div>

    <section class="tight">
      <div class="wrap prose">
        <div class="section-label">
          <div class="rule"></div>
          <h2>AI adoption and architecture</h2>
        </div>
        <p>
          AI is changing how software gets built. I use it as part of the same
          discipline: specification-driven, test-heavy and focused on continuous
          refactoring.
        </p>
        <p>
          A team with specifications and tests gets faster. A team without them
          produces more code than it can review.
        </p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-label">
          <div class="rule"></div>
          <h2>Selected work</h2>
        </div>

        <div class="case-grid">
          <div class="case">
            <div class="stat">
              2,600<span class="stat-label">stores, zero downtime</span>
            </div>
            <div class="content">
              <span class="category">Retail &middot; Backend modernization</span
              >
              <h3>Replacing a backend without stopping 2,600 stores</h3>
              <p>
                150 million documents and 1 TB of data migrated in place, across
                9,500 terminals. Result: 79% throughput gain and a 216&times;
                reduction in query time.
              </p>
            </div>
          </div>

          <div class="case">
            <div class="stat">
              18<span class="stat-label">microservices, AWS</span>
            </div>
            <div class="content">
              <span class="category">Mobility &amp; traffic management</span>
              <h3>
                Absorbing three national traffic feeds without a single-source
                model
              </h3>
              <p>
                HERE, TomTom and Radio24, each on a different schema and update
                cycle, unified into one platform. In production since 2017, more
                than 99.9% uptime.
              </p>
            </div>
          </div>

          <div class="case">
            <div class="stat">
              9M<span class="stat-label">calls / hour, peak</span>
            </div>
            <div class="content">
              <span class="category">Public sector</span>
              <h3>
                Architecture designed while requirements were still moving
              </h3>
              <p>
                The system grew to 400,000 entities and absorbed peak loads of 9
                million calls per hour before a wider modular redesign.
              </p>
            </div>
          </div>

          <div class="case">
            <div class="stat">
              3<span class="stat-label">cities, one architecture</span>
            </div>
            <div class="content">
              <span class="category">Luxury e-commerce</span>
              <h3>One architecture across three cities</h3>
              <p>
                A single shared architecture for a luxury brand across Berlin,
                Geneva and Shanghai, with local compliance and localization
                built into the design. It kept teams aligned across time zones.
              </p>
            </div>
          </div>

          <div class="case">
            <div class="stat">
              1<span class="stat-label">API contract, hundreds of clients</span>
            </div>
            <div class="content">
              <span class="category">Enterprise content</span>
              <h3>Headless CMS for Content as a Service</h3>
              <p>
                A single API contract for Crownpeak while hundreds of clients
                depended on the same content layer, reusable without forcing
                each client into bespoke integration.
              </p>
            </div>
          </div>

          <div class="case">
            <div class="stat">
              10<span class="stat-label">years, no rewrite</span>
            </div>
            <div class="content">
              <span class="category">Open source platform</span>
              <h3>Ten years of evolution without rewrite</h3>
              <p>
                RESTHeart evolved through major upstream changes while
                preserving a stable product and API. Unisys and Northrop Grumman
                used it as it grew into a hosted SaaS offering.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      posts.length > 0 && (
        <section>
          <div class="wrap">
            <div class="section-label">
              <div class="rule" />
              <h2>Latest writing</h2>
            </div>

            <div class="article-list">
              {posts.map((post) => (
                <div class="article-row">
                  <span class="cat">{post.data.tags[0] ?? "Article"}</span>
                  <a href={postPath(post.id)}>{post.data.title}</a>
                  <span class="date">{formatDate(post.data.date)}</span>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="tight">
      <div class="wrap">
        <div class="section-label">
          <div class="rule"></div>
          <h2>Get in touch</h2>
        </div>
        <ContactCta
          title="Thirty minutes to describe the situation and work out whether I am the right person for it."
          subtext="After the call, we decide whether the problem is a fit and what the next step should be."
        />
      </div>
    </section>
  </section>
</Base>
