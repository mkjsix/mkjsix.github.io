---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Software architecture and technical leadership for products that need to move fast. Fractional CTO, architecture reviews, and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Technical Leadership",
    "Fractional CTO",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
  ],
};
---

<Base
  title="Software Architecture and Technical Leadership — Maurizio Turatti"
  description="Software architecture and technical leadership for products that need to move fast. Fractional CTO, architecture reviews, and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Software architecture and technical leadership for products that need to move fast.
    </h1>
    <p class="hero-sub">
      I take on fractional CTO and advisory engagements where the combination of
      judgment and hands-on experience matters.
    </p>
  </div>

  <div class="section-stack">
    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">What I do</h2>
      <div class="card-grid">
        <div class="surface-card">
          <p class="card-label">Fractional CTO</p>
          <p class="card-text">
            Ongoing technical leadership, embedded in your team or available on call. Guiding decisions, translating business requirements into technical direction.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Architecture review</p>
          <p class="card-text">
            System design reviews, performance and security optimization, cloud migration planning. Fixed scope, clear objectives.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Technical due diligence</p>
          <p class="card-text">
            Independent technical evaluation on your side. Verifying a vendor's delivery, writing requirements for a tender, assessing production readiness.
          </p>
        </div>
      </div>
    </div>

    <!-- Credibility snippet -->
    <div class="section-block">
      <div class="section-body">
        <p>
          Co-founder of <strong>SoftInstigate</strong> and creator of
          <a href="https://restheart.org" target="_blank" rel="noopener">RESTHeart</a>,
          an open-source backend platform for MongoDB used in production worldwide.
          Former SOA architect at <strong>Sun Microsystems</strong> and technical architect at
          <strong>AKQA</strong> Berlin.
          <a href="/about">Full background →</a>
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Technical lead for modernization of a high-volume production backend:
              2,600+ stores, 9,500+ terminals, 141M+ documents, 1TB+ data.
              Throughput target exceeded by 79%, query time reduced 216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-text">
              Architectural assessment of a public-facing compliance platform:
              over a million users, millions of requests per hour, sub-second response times.
              Performance analysis and strategic roadmap.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 2M+ open-source downloads, 10+ years in production. Agent-ready backend for MongoDB,
              adopted by Fortune 500 companies including Unisys, Northrop Grumman, and Crownpeak.
            </p>
          </div>
        </div>
        <p style="margin-top: 16px;">
          <a href="/about">All selected work →</a>
        </p>
      </div>
    </div>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">Latest writing</h2>
        <div class="blog-list">
          {posts.map((post, index) => (
            <>
              <a href={postPath(post.id)} class="blog-item">
                <span class="blog-title">{post.data.title}</span>
                <span class="blog-meta">
                  {post.data.tags[0] && (
                    <span class="blog-tag">{post.data.tags[0]}</span>
                  )}
                  <span class="blog-date">{formatDate(post.data.date)}</span>
                </span>
              </a>
              {index < posts.length - 1 && (
                <hr class="section-separator blog-separator" />
              )}
            </>
          ))}
        </div>
        <p class="section-body" style="margin-top: 16px;">
          <a href="/writing">All writing →</a>
        </p>
      </div>
    )}
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
