---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Architectural Decision-Making",
    "Technical Risk Assessment",
    "Technical Leadership",
    "CTO Advisory",
    "Architecture Review",
    "Technical Due Diligence",
    "Technical Strategy",
    "Business Development",
    "Product Strategy",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "Stakeholder Management",
    "AI Integration",
    "Retrieval-Augmented Generation (RAG)",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
  ],
};
---

<Base
  title="Home - Maurizio Turatti"
  description="I help companies and teams make technical decisions that reduce complexity, risk, and future costs. Architecture advisory and technical due diligence."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Technical leadership with a business edge.
    </h1>
    <p class="hero-sub">
      Software architecture and technical leadership for products that need to
      move fast.
    </p>
  </div>

  <div class="section-stack">
    <!-- How I help -->
    <div class="section-block">
      <h2 class="section-title">How I help</h2>
      <div class="card-grid">
        <div class="surface-card">
          <span class="card-number">01</span>
          <p class="card-label">
            &ldquo;We are building fast, but I cannot tell if we are going in
            the right direction.&rdquo;
          </p>
          <p class="card-text">
            The product is moving. You need someone to look at the technical
            side and tell you whether the foundation is solid or accumulating
            problems that will cost you later.
          </p>
        </div>
        <div class="surface-card">
          <span class="card-number">02</span>
          <p class="card-label">
            &ldquo;We need to scale and I don&rsquo;t know if the architecture
            will hold.&rdquo;
          </p>
          <p class="card-text">
            The system works now. The question is whether it will work at 10x the load in the future. That is the architecture problem you need to solve before it becomes a crisis.
          </p>
        </div>
        <div class="surface-card">
          <span class="card-number">03</span>
          <p class="card-label">
            &ldquo;I am non-technical and I need to make decisions about a
            team or a provider.&rdquo;
          </p>
          <p class="card-text">
            Hiring, evaluating an agency, choosing a stack, deciding whether to
            rebuild or refactor. You need someone to assess the technical side
            without selling you anything.
          </p>
        </div>
        <div class="surface-card">
          <span class="card-number">04</span>
          <p class="card-label">
            &ldquo;We need an independent technical opinion on what we are
            building.&rdquo;
          </p>
          <p class="card-text">
            Internal teams, corporate ventures, strategic projects. You have the
            skills. You need someone outside the team who can look at the
            technical side independently.
          </p>
        </div>
        <div class="surface-card">
          <span class="card-number">05</span>
          <p class="card-label">
            &ldquo;I don&rsquo;t know if the product is accumulating tech debt.&rdquo;
          </p>
          <p class="card-text">
            The team ships on schedule. But you cannot tell whether the codebase
            is holding together or getting harder to change. You need someone to
            look at it and tell you directly.
          </p>
        </div>
        <div class="surface-card">
          <span class="card-number">06</span>
          <p class="card-label">
            &ldquo;Should we keep building on what we have or start
            over?&rdquo;
          </p>
          <p class="card-text">
            A rewrite costs months. Building on a shaky foundation costs years.
            The answer depends on what is actually broken.
          </p>
        </div>
      </div>
    </div>

    <!-- How it works -->
    <div class="section-block">
      <div class="section-body">
        <p>
          My recommendations come from over two decades of building systems and
          living with the consequences of those decisions. Technical and
          commercial considerations shape each other from the start. <a
            href="/about">How I think →</a
          >
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Replacing the backend without stopping 2,600+ stores and 9,500+
              terminals. No downtime allowed. A wrong data migration would have
              been visible in every store the next morning. 141M+ documents,
              1TB+ data. Throughput target exceeded by 79%, query time reduced
              216x.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Luxury e-commerce</p>
            <p class="card-text">
              Three cities, three teams, one architecture. Distributed teams in
              Berlin, Geneva, and Shanghai building a luxury brand's e-commerce
              platform for China. Localization in Chinese and compliance with
              Chinese authority security requirements. Architectural decisions
              coordinated across three time zones.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Mobility &amp; traffic management</p>
            <p class="card-text">
              Multiple national traffic sources, each with a different schema
              and update cycle. No single source of truth, and consumers relying
              on the output daily. 18 microservices on AWS, 10,000+ events/day,
              99.9% uptime. Serving HERE, TomTom, Radio24. In production since
              2017.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Public sector</p>
            <p class="card-text">
              400K+ entities, 9M+ API calls/hour at peak. Requirements still
              forming while the architecture needed to proceed. Optimizing Redis
              to relieve database pressure and building a roadmap from monolith
              toward modular architecture.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Enterprise content</p>
            <p class="card-text">
              Persistence and API layer for Crownpeak, deployed on Kubernetes to
              thousands of enterprise clients globally. One API contract,
              thousands of clients depending on it.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 10+ years in production, 2M+ downloads. Architecture
              that evolved without rewrite across many major versions and
              breaking upstream changes. Adopted by Unisys, Northrop Grumman,
              and Crownpeak.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Latest writing -->
    {
      posts.length > 0 && (
        <div class="section-block">
          <h2 class="section-title">Latest writing</h2>
          <div class="blog-list">
            {posts.map((post, index) => (
              <>
                <a href={postPath(post.id)} class="blog-item">
                  <span class="blog-title">{post.data.title}</span>
                  <span class="blog-meta">
                    {post.data.tags[0] && (
                      <span class="blog-tag">{post.data.tags[0]}</span>
                    )}
                    <span class="blog-date">{formatDate(post.data.date)}</span>
                  </span>
                </a>
                {index < posts.length - 1 && (
                  <hr class="section-separator blog-separator" />
                )}
              </>
            ))}
          </div>
          <p class="section-body" style="margin-top: 16px;">
            <a href="/writing">All writing →</a>
          </p>
        </div>
      )
    }
  </div>

  <ContactCta />
</Base>
