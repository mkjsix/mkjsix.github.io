---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ContactCta from "../components/ContactCta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "I work with founders, CTOs and boards on the technical decisions that come before a significant investment, and bring architectural discipline to AI-assisted development.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Technical Assessment",
    "Legacy System Modernization",
    "Java",
    "AWS",
    "MongoDB",
  ],
};
---

<Base
  title="Maurizio Turatti | Software Architecture & Technical Strategy"
  description="I work with founders, CTOs and boards on the technical decisions that come before a significant investment, and bring architectural discipline to AI-assisted development."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <header class="hero grid-bg">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="eyebrow mono">
          Software architecture &middot; System design
        </div>
        <h1><em>Decisions</em> made before certainty</h1>
        <p>
          I work with founders, CTOs and boards on the technical decisions that
          come before a significant investment. I bring architectural discipline
          to AI-assisted development.
        </p>
        <div class="actions">
          <a
            href="mailto:info@maurizioturatti.com"
            class="btn"
            data-goatcounter-click="contact-hero:/"
            >Tell me what you're building</a
          >
          <a href="#work" class="link">Selected work</a>
        </div>
      </div>
      <img
        class="hero-visual"
        src="/images/hero-visual.svg"
        width="360"
        height="380"
        alt=""
        aria-hidden="true"
      />
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Typical engagements</h2>
      </div>

      <div class="help-list">
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="16" cy="16" r="13"></circle><path
                d="M21 11l-4 8-8 4 4-8 8-4z"></path><circle
                cx="16"
                cy="16"
                r="1.4"
                fill="var(--accent)"
                stroke="none"></circle></svg
            ></span
          >
          <div>
            <span class="category">Build from architecture to production</span>
            <p>
              You have an MVP to build, starting from an idea or a prototype,
              and need senior technical leadership to design and deliver it.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><path d="M4 27h24" stroke-linecap="round"></path><rect
                x="7"
                y="18"
                width="4.5"
                height="9"></rect><rect x="14" y="12" width="4.5" height="15"
              ></rect><rect x="21" y="6" width="4.5" height="21"></rect></svg
            ></span
          >
          <div>
            <span class="category">Scale a system in production</span>
            <p>
              Your system starts to break under growth: response times, security
              findings or infrastructure costs grow faster than the number of
              users.
            </p>
          </div>
        </div>
        <div class="help-item">
          <span class="icon"
            ><svg
              viewBox="0 0 32 32"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.4"
              ><circle cx="14" cy="14" r="8"></circle><path
                d="M20 20l7 7"
                stroke-linecap="round"></path></svg
            ></span
          >
          <div>
            <span class="category">Oversee an external supplier</span>
            <p>
              Your software is built by a supplier and you need someone on your
              side who can judge estimates, answers and releases.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Selected work</h2>
      </div>

      <div class="case-grid">
        <div class="case">
          <div class="stat">
            &lt;4 h<span class="stat-label"
              >downtime since 2017, none in the last three years</span
            >
          </div>
          <div class="content">
            <span class="category"
              >Mobility &middot; National traffic information</span
            >
            <h3>Replacing an inherited traffic information system</h3>
            <p>
              After ACI group acquired its traffic agency, I assessed the
              inherited PHP and Oracle system: it could not scale and went down
              repeatedly. I designed its replacement: 18 services on AWS that
              merge six sources on DATEX II, GTFS and TMC every 3 to 5 minutes
              and serve about 10,000 events a day to HERE, TomTom, Radio24 and
              others.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            9%<span class="stat-label"
              >average database CPU at 9M API calls per hour</span
            >
          </div>
          <div class="content">
            <span class="category"
              >Public sector &middot; National compliance register</span
            >
            <h3>Locating the load on a register of 400,000 business sites</h3>
            <p>
              54% of database waits came from writing a log row for every API
              request: 2 billion rows, 13 TB. Caching token validation cut total
              SQL time by 77% and database CPU by 89% in load tests. I led the
              architecture review and the caching strategy with Redis on top of
              the database.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            216&times;<span class="stat-label"
              >query time, from 325 s to 1.5 s</span
            >
          </div>
          <div class="content">
            <span class="category"
              >Retail &middot; Fiscal and EDI documents</span
            >
            <h3>Moving 150 million documents off SQL Server</h3>
            <p>
              12 servers processed 6,000 files an hour, but searches took
              minutes and history was limited to two months. MongoDB won a
              competitive PoC against SQL Server and Oracle. In the design
              benchmark, the new write path sustained 537 writes per second
              against the 300 required for ten times the volume.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            7,500<span class="stat-label"
              >historical responses as statistical baseline</span
            >
          </div>
          <div class="content">
            <span class="category">HR tech &middot; Behavioural assessment</span
            >
            <h3>Moving a scoring method out of Excel</h3>
            <p>
              A behavioural assessment method, which scores candidates against
              role profiles, lived in a spreadsheet with its algorithms and
              7,500 past responses. I rewrote the scoring engine in Java on
              RESTHeart and MongoDB, with tests that compare profiles and
              population statistics against the spreadsheet. The multi-tenant
              web application reached production in under three months.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            4<span class="stat-label">cities, one architecture</span>
          </div>
          <div class="content">
            <span class="category">Luxury e-commerce</span>
            <h3>One architecture across four cities</h3>
            <p>
              A single shared e-commerce platform on Adobe AEM for a luxury
              brand: frontend in Berlin, backend in Gurgaon, deployment in
              Shanghai, client in Geneva. Local compliance and Chinese localization were
              built into the design.
            </p>
          </div>
        </div>

        <div class="case">
          <div class="stat">
            2M+<span class="stat-label">Docker pulls of RESTHeart</span>
          </div>
          <div class="content">
            <span class="category">Own products &middot; Open source</span>
            <h3>Products I build and operate</h3>
            <p>
              I co-created <a href="https://restheart.org/">RESTHeart</a>, the
              open source backend for MongoDB, in 2014: more than ten years in
              production, adopted by Unisys, Northrop Grumman, Crownpeak and
              others.{" "}
              <a href="https://cloud.restheart.com/">RESTHeart Cloud</a>,{" "}
              <a href="https://www.softinstigate.com/en/mobility/">MobiStream</a
              >{" "}
              and <a href="https://bysophia.ai/">Sophia</a>, a RAG platform, are
              built on it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>AI-assisted development</h2>
      </div>
      <div class="ai-grid">
        <div class="prose">
          <p>
            Building software with AI keeps getting faster. When producing code
            takes less time, it matters more to know what that code will cost in
            fixes, maintenance and downtime.
          </p>
          <p>
            AI-written code almost always looks good, even when it is fragile
            inside. To assess it, you need to know the practices by which it was
            designed, tested and prepared for production.
          </p>
          <p>I organize agentic development with Lean engineering practices.</p>
          <p>
            Agents need explicit job descriptions and hard guardrails. The
            workflow operates as a pull system: well-specified tasks wait on a
            board, where dedicated agents pull work within their scope,
            implement changes, and validate them against tests.
          </p>
          <p>
            Without that structure, agents generate more code than anyone can
            review.
          </p>
        </div>
        <svg
          class="ai-visual"
          viewBox="0 0 260 200"
          fill="none"
          aria-hidden="true"
        >
          <defs>
            <marker
              id="ai-arrow"
              viewBox="0 0 8 8"
              refX="7"
              refY="4"
              markerWidth="6"
              markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M0 0L8 4L0 8z" fill="var(--text-muted)"></path>
            </marker>
          </defs>
          <rect
            x="86"
            y="12"
            width="88"
            height="44"
            rx="3"
            stroke="var(--accent)"
            stroke-width="2"></rect>
          <circle
            cx="130"
            cy="34"
            r="10"
            stroke="var(--accent)"
            stroke-width="1.4"></circle>
          <path
            d="M125 34L129 38L136 30"
            stroke="var(--accent)"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M100 56L42 137"
            stroke="var(--text-muted)"
            stroke-width="1.2"
            marker-end="url(#ai-arrow)"></path>
          <path
            d="M124 56V129"
            stroke="var(--text-muted)"
            stroke-width="1.2"
            marker-end="url(#ai-arrow)"></path>
          <path
            d="M160 56L218 137"
            stroke="var(--text-muted)"
            stroke-width="1.2"
            marker-end="url(#ai-arrow)"></path>
          <path
            d="M54 140L112 59"
            stroke="var(--text-muted)"
            stroke-opacity=".6"
            stroke-width="1.2"
            stroke-dasharray="3 3"
            marker-end="url(#ai-arrow)"></path>
          <path
            d="M136 132V59"
            stroke="var(--text-muted)"
            stroke-opacity=".6"
            stroke-width="1.2"
            stroke-dasharray="3 3"
            marker-end="url(#ai-arrow)"></path>
          <path
            d="M206 140L148 59"
            stroke="var(--text-muted)"
            stroke-opacity=".6"
            stroke-width="1.2"
            stroke-dasharray="3 3"
            marker-end="url(#ai-arrow)"></path>
          <rect
            x="24"
            y="140"
            width="48"
            height="28"
            rx="2"
            stroke="var(--accent)"
            stroke-width="1.2"></rect>
          <rect
            x="100"
            y="132"
            width="60"
            height="40"
            rx="2"
            stroke="var(--accent)"
            stroke-width="1.4"></rect>
          <rect
            x="190"
            y="140"
            width="44"
            height="24"
            rx="2"
            stroke="var(--accent)"
            stroke-width="1.1"></rect>
        </svg>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section>
        <div class="wrap">
          <div class="section-label">
            <div class="rule" />
            <h2>Latest writing</h2>
          </div>

          <div class="article-list">
            {posts.map((post) => (
              <div class="article-row">
                <span class="cat">{post.data.tags[0] ?? "Article"}</span>
                <a href={postPath(post.id)}>{post.data.title}</a>
                <span class="date">{formatDate(post.data.date)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="discovery">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Discovery</h2>
      </div>
      <div class="prose">
        <p>
          A new product starts with a Discovery. It takes two to four weeks at
          a fixed price.
        </p>
      </div>
      <div class="steps">
        <div class="step">
          <h3>Business</h3>
          <p>
            I start from the goals of the initiative, the obstacles in the way
            and the criteria that measure success. I map the main processes and
            the people involved.
          </p>
        </div>
        <div class="step">
          <h3>Technology</h3>
          <p>
            I choose the architecture, the technologies and the infrastructure
            of the system. If a prototype exists, I use it as the specification.
            I keep its technologies when there is a reason to.
          </p>
        </div>
        <div class="step">
          <h3>Scenarios</h3>
          <p>
            I define what the project includes and what it excludes, and in
            which order. Each possible approach comes with its assumptions,
            dependencies and risks, and an indicative timeline.
          </p>
        </div>
        <div class="step">
          <h3>Document</h3>
          <p>
            You get a written document with enough information to decide go or
            no-go, and a realistic cost range for development. It is yours and
            can be used with another supplier.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="section-label">
        <div class="rule"></div>
        <h2>Get in touch</h2>
      </div>
      <ContactCta />
    </div>
  </section>
</Base>
