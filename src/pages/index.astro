---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

const postPath = (id: string) => `/writing/${id.replace(/\.md$/, "")}`;

const consultingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://maurizioturatti.com/#service",
  name: "Maurizio Turatti",
  image: "https://maurizioturatti.com/images/og-image.png",
  url: "https://maurizioturatti.com/",
  description:
    "Software architecture and technical leadership for teams that need to move fast. Fractional CTO and advisory engagements across people, processes, and platforms.",
  areaServed: "Europe and North America",
  knowsAbout: [
    "Software Architecture",
    "Technical Leadership",
    "Fractional CTO",
    "Technical Strategy",
    "Technical Due Diligence",
    "Distributed Systems",
    "Stakeholder Management",
    "AI Integration",
  ],
};
---

<Base
  title="Software Architecture and Technical Leadership — Maurizio Turatti"
  description="Software architecture and technical leadership for products that need to move fast. Fractional CTO and advisory engagements across people, processes, and platforms."
  ogImage="/images/og-image.png"
  jsonLd={consultingJsonLd}
>
  <!-- Hero -->
  <div class="hero hero--first">
    <h1 class="hero-headline hero-headline--lg">
      Software architecture and technical leadership for products that need to move fast.
    </h1>
    <p class="hero-sub">
      I take on fractional CTO and advisory engagements where the combination of
      judgment and hands-on experience matters.
    </p>
  </div>

  <div class="section-stack">
    <!-- Who this is for — pain points -->
    <div class="section-block">
      <h2 class="section-title">Problems I solve</h2>
      <div class="card-grid">
        <div class="surface-card">
          <p class="card-label">Scaling</p>
          <p class="card-text">
            Slow APIs, databases under pressure, infrastructure that requires heroics to keep running.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">Team</p>
          <p class="card-text">
            Decisions that stall, technical debt that nobody owns, engineers firefighting instead of building.
          </p>
        </div>
        <div class="surface-card">
          <p class="card-label">New build</p>
          <p class="card-text">
            You are starting something new and want to get the architecture right from the beginning.
          </p>
        </div>
      </div>
    </div>

    <!-- Credibility snippet -->
    <div class="section-block">
      <div class="section-body">
        <p>
          Co-founder of <strong>SoftInstigate</strong> and creator of
          <a href="https://restheart.org" target="_blank" rel="noopener">RESTHeart</a>,
          an open-source backend platform for MongoDB used in production worldwide.
          Former SOA architect at <strong>Sun Microsystems</strong> and technical architect at
          <strong>AKQA</strong> Berlin.
          <a href="/about">Full background →</a>
        </p>
      </div>
    </div>

    <!-- What I do -->
    <div class="section-block">
      <h2 class="section-title">What I do</h2>
      <div class="section-body">
        <p>
          <strong>Architecture reviews, fractional CTO, and technical leadership</strong>
          for products that need to move fast.
        </p>
        <p>
          A recurring part of my work sits between business and IT, translating business requirements
          into technical decisions and technical constraints into language that product and leadership
          can act on. That translation layer is often where projects stall, and where I tend to be most useful.
        </p>
        <p>
          Sometimes that means acting as an independent technical voice on the client's side: evaluating what a vendor is delivering, writing the technical requirements for a tender, or verifying that a system is actually ready to go live. My interest is aligned with yours, not with the supplier's.
        </p>
        <p>
          AI-augmented development is part of how I work, treated as an infrastructure problem
          built on top of existing data, processes, and systems. It shifts what's feasible
          with small, senior engineering groups.
        </p>
      </div>
    </div>

    <!-- Selected results -->
    <div class="section-block">
      <h2 class="section-title">Selected work</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Retail, backend modernization</p>
            <p class="card-text">
              Technical lead for modernization of a high-volume production backend:
              2,600+ stores, 9,500+ terminals, 141M+ documents, 1TB+ data.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Environmental compliance</p>
            <p class="card-text">
              Architectural assessment of a national waste tracking platform:
              1M+ users, 7M API calls/hr, p95 &lt; 300ms.
              Performance analysis and strategic roadmap.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Open source platform</p>
            <p class="card-text">
              RESTHeart: 10+ years of continuous development. Agent-ready backend for MongoDB,
              adopted in production by startups and Fortune 500 companies worldwide.
            </p>
          </div>
        </div>
        <p style="margin-top: 16px;">
          <a href="/about">All selected work →</a>
        </p>
      </div>
    </div>

    <!-- Latest writing -->
    {posts.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">Latest writing</h2>
        <div class="blog-list">
          {posts.map((post, index) => (
            <>
              <a href={postPath(post.id)} class="blog-item">
                <span class="blog-title">{post.data.title}</span>
                <span class="blog-meta">
                  {post.data.tags[0] && (
                    <span class="blog-tag">{post.data.tags[0]}</span>
                  )}
                  <span class="blog-date">{formatDate(post.data.date)}</span>
                </span>
              </a>
              {index < posts.length - 1 && (
                <hr class="section-separator blog-separator" />
              )}
            </>
          ))}
        </div>
        <p class="section-body" style="margin-top: 16px;">
          <a href="/writing">All writing →</a>
        </p>
      </div>
    )}
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
