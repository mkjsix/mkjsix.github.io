---
import Base from "../layouts/Base.astro";
import ContactCta from "../components/ContactCta.astro";

const servicePageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://maurizioturatti.com/work-with-me/#service",
  serviceType: "Fractional CTO and software architecture advisory",
  provider: {
    "@type": "Person",
    name: "Maurizio Turatti",
    url: "https://maurizioturatti.com/",
  },
  areaServed: "Europe and North America",
  url: "https://maurizioturatti.com/work-with-me/",
  description:
    "Fractional CTO, architecture reviews, and technical due diligence. Advisory for products that need to move fast.",
  knowsAbout: [
    "Software Architecture",
    "Technical Leadership",
    "Fractional CTO",
    "Technical Strategy",
    "Stakeholder Management",
    "Distributed Systems",
    "API Design",
    "Data Modeling",
    "HTTP, REST, WebSocket, SSE",
    "AI Integration",
  ],
};
---

<Base
  title="Work with me — Maurizio Turatti"
  description="Fractional CTO, architecture reviews, and technical due diligence. Advisory for products that need to move fast."
  ogImage="/images/og-image.png"
  jsonLd={servicePageJsonLd}
>
  <div class="hero hero--first">
    <p class="hero-eyebrow">Work with me</p>
    <h1 class="hero-headline">Every engagement starts with a conversation.</h1>
  </div>

  <div class="page-content section-stack">
    <div class="section-block">
      <div class="section-body section-body--lead section-body--spacious">
        <p>
          Write to <a href="mailto:info@maurizioturatti.com">info@maurizioturatti.com</a>
          and describe your situation in a few lines. We figure out together what
          kind of help makes sense, if any.
          <a href="/about">Background and selected work →</a>
        </p>
      </div>
    </div>

    <div class="section-block">
      <h2 class="section-title">Engagement models</h2>
      <div class="section-body">
        <div class="card-grid">
          <div class="surface-card">
            <p class="card-label">Fractional CTO</p>
            <p class="card-text">
              Ongoing technical leadership for teams that need a senior voice
              but not a full-time hire. Embedded or on call, typically three to twelve months.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Architecture review</p>
            <p class="card-text">
              Written assessment with findings, prioritised recommendations,
              and a phased roadmap. Fixed scope, typically two to four weeks.
            </p>
          </div>
          <div class="surface-card">
            <p class="card-label">Technical due diligence</p>
            <p class="card-text">
              Independent technical evaluation on your side: vendor deliveries,
              tender proposals, production readiness. Enough detail for your
              leadership team to decide.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="section-block">
      <div class="section-body section-body--spacious">
        <p>
          Decisions get made faster, teams stop going in circles, and the technical
          path forward becomes clear.
          <a href="/about">See selected work and outcomes →</a>
        </p>
      </div>
    </div>
  </div>

  <ContactCta subtext="info@maurizioturatti.com" />
</Base>
