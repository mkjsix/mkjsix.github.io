---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  maxWidth?: string;
}

const {
  title = 'Maurizio Turatti',
  description = 'Technical strategy with a business edge. Software architecture and system design for products that need to move fast.',
  canonical,
  noindex = false,
  ogType = 'website',
  ogImage = '/images/og-image.png',
  ogImageAlt = 'Portrait of Maurizio Turatti',
  publishedTime,
  modifiedTime,
  articleTags = [],
  jsonLd,
  maxWidth,
} = Astro.props;

const siteOrigin = Astro.site ? new URL('/', Astro.site).toString() : `${Astro.url.origin}/`;
const canonicalURL = canonical
  ? new URL(canonical, siteOrigin).toString()
  : new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageURL = new URL(ogImage, siteOrigin).toString();
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}#website`,
  url: siteOrigin,
  name: 'Maurizio Turatti',
  description,
  inLanguage: 'en',
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteOrigin}#person`,
  name: 'Maurizio Turatti',
  url: siteOrigin,
  image: ogImageURL,
  jobTitle: 'Technical and Commercial Advisor',
  knowsAbout: [
    'Software Architecture',
    'Architectural Decision-Making',
    'Technical Risk Assessment',
    'Technical strategy',
    'CTO Advisory',
    'Architecture Review',
    'Technical Due Diligence',
    'Technical Strategy',
    'Business Development',
    'Lead Evaluation',
    'Public Sector Tender Assessment',
    'Private Sector Tender Assessment',
    'Partnership Structuring',
    'Partner Management',
    'Vendor Management',
    'Contract Negotiation',
    'Pre-Sales Technical Framing',
    'RFP Response Management',
    'Client-Facing Delivery',
    'Distributed Systems',
    'API Design',
    'Data Modeling',
    'HTTP, REST, WebSocket, SSE',
    'Stakeholder Management',
    'AI Integration',
  ],
  sameAs: ['https://www.linkedin.com/in/maurizioturatti', 'https://github.com/mkjsix', 'https://stackoverflow.com/users/615095/mturatti', 'https://x.com/mkj6'],
};

const pageJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const structuredData = [websiteJsonLd, personJsonLd, ...pageJsonLd];

const isAbout = Astro.url.pathname === '/about/';
const isWriting = Astro.url.pathname.startsWith('/writing');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://m.maurizioturatti.com" crossorigin />
    <link rel="preconnect" href="https://assets.calendly.com" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Maurizio Turatti" />
    <meta name="theme-color" content="#1a1410" />
    <link rel="canonical" href={canonicalURL} />
    <slot name="head" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Maurizio Turatti" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:site" content="@mkj6" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <nav class="site-nav grid-bg" style="position:relative;">
      <a href="/" class="brand">MAURIZIO <span>TURATTI</span></a>
      <ul class="site-nav-links">
        <li><a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a></li>
        <li><a href="/writing" aria-current={isWriting ? 'page' : undefined}>Writing</a></li>
      </ul>
      <a href="https://calendly.com/maurizioturatti-info/30min" class="btn" data-calendly>Book a call</a>
      <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span class="nav-hamburger"></span>
      </button>
      <div class="nav-drawer" hidden>
        <ul class="nav-drawer-links">
          <li><a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a></li>
          <li><a href="/writing" aria-current={isWriting ? 'page' : undefined}>Writing</a></li>
        </ul>
        <a href="https://calendly.com/maurizioturatti-info/30min" class="btn" data-calendly>Book a call</a>
      </div>
    </nav>
    <script>
      (function() {
        const toggle = document.querySelector('.nav-toggle');
        const drawer = document.querySelector('.nav-drawer');
        if (!toggle || !drawer) return;

        function openMenu() {
          drawer.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.classList.add('nav-toggle--open');
        }
        function closeMenu() {
          drawer.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.classList.remove('nav-toggle--open');
        }

        toggle.addEventListener('click', function() {
          if (drawer.hasAttribute('hidden')) { openMenu(); } else { closeMenu(); }
        });

        drawer.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', closeMenu);
        });

        document.addEventListener('click', function(e) {
          if (!drawer.hasAttribute('hidden') && !drawer.contains(e.target) && !toggle.contains(e.target)) {
            closeMenu();
          }
        });
      })();
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="mono"><a href="mailto:info@maurizioturatti.com">info@maurizioturatti.com</a></span>
        <div class="mono footer-social">
          <a href="https://www.linkedin.com/in/maurizioturatti" target="_blank" rel="noopener">LinkedIn</a>
          &middot;
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener">GitHub</a>
          &middot;
          <a href="https://stackoverflow.com/users/615095/mturatti" target="_blank" rel="noopener">Stack Overflow</a>
        </div>
        <div class="footer-legal">
          <span>PEC: <a href="mailto:maurizio.turatti@legalmail.it">maurizio.turatti@legalmail.it</a></span>
          <span>P.IVA 02452460039</span>
          <span>SDI: M5UXCR1</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function() {
        var ready = false, loading = false;
        function ensureLoaded(callback) {
          if (ready) { callback(); return; }
          if (loading) { window._calendlyQueue.push(callback); return; }
          loading = true; window._calendlyQueue = [callback];
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://assets.calendly.com/assets/external/widget.css';
          document.head.appendChild(link);
          var s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.onload = function() {
            ready = true;
            window._calendlyQueue.forEach(function(fn) { fn(); });
          };
          s.onerror = function() { loading = false; };
          document.head.appendChild(s);
        }
        function preload() { ensureLoaded(function() {}); }
        document.querySelectorAll('[data-calendly]').forEach(function(el) {
          el.addEventListener('mouseenter', preload);
          el.addEventListener('focus', preload);
          el.addEventListener('click', function(e) {
            e.preventDefault();
            var url = e.currentTarget.href;
            ensureLoaded(function() { Calendly.initPopupWidget({url: url}); });
          });
        });
      })();
    </script>

    <script data-goatcounter="https://mturatti.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </body>
</html>
