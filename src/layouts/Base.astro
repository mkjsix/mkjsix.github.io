---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Maurizio Turatti',
  description = 'Software architect and product engineer. Technical leadership for teams that need to move faster without breaking things.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <div class="container">
      <nav>
        <div class="nav-inner">
          <a href="/" class="nav-logo">
            <img src="/images/maurizio.jpeg" alt="Avatar Maurizio Turatti" class="avatar" width="36" height="36" />
            <span>Maurizio Turatti</span>
          </a>
          <ul class="nav-links">
            <li><a href="/writing">Writing</a></li>
            <li><a href="/work-with-me">Work with me</a></li>
          </ul>
          <a href="mailto:info@maurizioturatti.com" class="nav-cta">Get in touch</a>
        </div>
      </nav>
      <hr class="section-separator section-separator-nav" />

      <main>
        <slot />
      </main>

      <hr class="section-separator" />

      <footer>
        <span class="footer-name"><a href="mailto:info@maurizioturatti.com">info@maurizioturatti.com</a></span>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/maurizioturatti" target="_blank" rel="noopener" class="footer-link footer-link--linkedin">
            LinkedIn
          </a>
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener" class="footer-link footer-link--github">
            GitHub
          </a>
        </div>
        <div class="footer-legal">
          <span>PEC: <a href="mailto:maurizio.turatti@legalmail.it">maurizio.turatti@legalmail.it</a></span>
          <span>P.IVA 02452460039</span>
          <span>SDI: M5UXCR1</span>
        </div>
      </footer>
    </div>
  </body>
</html>
