---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'Maurizio Turatti',
  description = 'Software architecture and technical leadership for teams that need to move fast. Hands-on work with Java, JavaScript, TypeScript, Python, MongoDB, AWS, API design.',
  canonical,
  noindex = false,
  ogType = 'website',
  ogImage = '/images/maurizio.jpeg',
  ogImageAlt = 'Portrait of Maurizio Turatti',
  publishedTime,
  modifiedTime,
  articleTags = [],
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ? new URL('/', Astro.site).toString() : `${Astro.url.origin}/`;
const canonicalURL = canonical
  ? new URL(canonical, siteOrigin).toString()
  : new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageURL = new URL(ogImage, siteOrigin).toString();
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}#website`,
  url: siteOrigin,
  name: 'Maurizio Turatti',
  description,
  inLanguage: 'en',
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteOrigin}#person`,
  name: 'Maurizio Turatti',
  url: siteOrigin,
  image: ogImageURL,
  jobTitle: 'Software Architect',
  knowsAbout: [
    'Software Architecture',
    'Technical Leadership',
    'Backend Engineering',
    'Java',
    'MongoDB',
    'AWS',
    'REST API Design',
    'AI Integration',
  ],
  sameAs: ['https://www.linkedin.com/in/maurizioturatti', 'https://github.com/mkjsix'],
};

const pageJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

const structuredData = [websiteJsonLd, personJsonLd, ...pageJsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Maurizio Turatti" />
    <meta name="theme-color" content="#f6f5f0" />
    <link rel="canonical" href={canonicalURL} />
    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Maurizio Turatti" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    {structuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=DM+Serif+Display&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <div class="container">
      <nav>
        <div class="nav-inner">
          <a href="/" class="nav-logo">
            <img src="/images/maurizio.jpeg" alt="Avatar Maurizio Turatti" class="avatar" width="36" height="36" />
            <span>Maurizio Turatti</span>
          </a>
          <ul class="nav-links">
            <li><a href="/writing">Writing</a></li>
            <li><a href="/work-with-me">Work with me</a></li>
          </ul>
          <a href="mailto:info@maurizioturatti.com" class="nav-cta">Get in touch</a>
        </div>
      </nav>
      <hr class="section-separator section-separator-nav" />

      <main>
        <slot />
      </main>

      <hr class="section-separator" />

      <footer>
        <span class="footer-name"><a href="mailto:info@maurizioturatti.com">info@maurizioturatti.com</a></span>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/maurizioturatti" target="_blank" rel="noopener" class="footer-link footer-link--linkedin">
            LinkedIn
          </a>
          <a href="https://github.com/mkjsix" target="_blank" rel="noopener" class="footer-link footer-link--github">
            GitHub
          </a>
        </div>
        <div class="footer-legal">
          <span>PEC: <a href="mailto:maurizio.turatti@legalmail.it">maurizio.turatti@legalmail.it</a></span>
          <span>P.IVA 02452460039</span>
          <span>SDI: M5UXCR1</span>
        </div>
      </footer>
    </div>
  </body>
</html>
