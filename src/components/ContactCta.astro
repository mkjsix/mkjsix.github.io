---
interface Props {
  title?: string;
  subtext?: string;
  email?: string;
  buttonLabel?: string;
}

const {
  title = 'A 30-minute call to understand your situation, surface the key technical decisions, and determine if I can help.',
  subtext,
  email = 'info@maurizioturatti.com',
  buttonLabel = 'Book a call',
} = Astro.props;
---

<div class="cta-block">
  <div>
    <p class="cta-text">{title}</p>
    {subtext && <p class="cta-sub"><a href={`mailto:${subtext}`}>{subtext}</a></p>}
  </div>
  <a href="https://calendly.com/maurizioturatti-info/30min" class="cta-btn" data-calendly>{buttonLabel}</a>
</div>