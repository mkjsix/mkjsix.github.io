---
interface Props {
  title?: string;
  subtext?: string;
  email?: string;
  buttonLabel?: string;
}

const {
  title = 'Book a conversation',
  subtext,
  email = 'info@maurizioturatti.com',
  buttonLabel = 'Book a conversation',
} = Astro.props;
---

<div class="cta-block">
  <div>
    <p class="cta-text">{title}</p>
    {subtext && <p class="cta-sub"><a href={`mailto:${subtext}`}>{subtext}</a></p>}
  </div>
  <a href="https://calendly.com/maurizioturatti-info/30min" class="cta-btn" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/maurizioturatti-info/30min'}); return false;">{buttonLabel}</a>
</div>