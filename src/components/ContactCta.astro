---
interface Props {
  title?: string;
  subtext?: string;
  email?: string;
  buttonLabel?: string;
}

const {
  title = 'Send me a short brief by email.',
  subtext = 'A few paragraphs on what you are building or changing and the decision in front of you. I reply in writing with what I would look into first.',
  email = 'info@maurizioturatti.com',
  buttonLabel = 'Send a brief',
} = Astro.props;
---

<div class="cta-block">
  <div>
    <p class="cta-text">{title}</p>
    {subtext && (
      <p class="cta-sub">
        {subtext.includes('@') ? (
          <a href={`mailto:${subtext}`}>{subtext}</a>
        ) : (
          subtext
        )}
      </p>
    )}
  </div>
  <a href={`mailto:${email}?subject=Brief%3A%20`} class="btn">{buttonLabel}</a>
</div>
