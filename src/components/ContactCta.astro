---
interface Props {
  title?: string;
  subtext?: string;
  email?: string;
  buttonLabel?: string;
}

const {
  title = 'Ready to talk?',
  subtext,
  email = 'info@maurizioturatti.com',
  buttonLabel = 'Get in touch',
} = Astro.props;
---

<div class="cta-block">
  <div>
    <p class="cta-text">{title}</p>
    {subtext && <p class="cta-sub">{subtext}</p>}
  </div>
  <a href={`mailto:${email}`} class="cta-btn">{buttonLabel}</a>
</div>