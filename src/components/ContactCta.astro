---
interface Props {
  title?: string;
  subtext?: string;
  email?: string;
  buttonLabel?: string;
}

const {
  title = "Tell me what you're building.",
  subtext = '',
  email = 'info@maurizioturatti.com',
  buttonLabel = 'Write to me',
} = Astro.props;
---

<div class="cta-block">
  <div>
    <p class="cta-text">{title}</p>
    {subtext && (
      <p class="cta-sub">
        {subtext.includes('@') ? (
          <a href={`mailto:${subtext}`}>{subtext}</a>
        ) : (
          subtext
        )}
      </p>
    )}
  </div>
  <a href={`mailto:${email}`} class="btn">{buttonLabel}</a>
</div>
